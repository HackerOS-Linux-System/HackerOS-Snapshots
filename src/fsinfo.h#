mod util
mod config

;; "btrfs" | "ext4" | anything else findmnt reports (unsupported)
pub fn detect_fs(path: string) -> string is
    return util::capture("findmnt -no FSTYPE -T " + util::sq(path) + " 2>/dev/null | head -1")
end

pub fn effective(c: config::Config) -> string is
    let f: string = config::s(c, "fstype")
    if f == "btrfs" || f == "ext4" is return f end
    return detect_fs(config::s(c, "source"))
end

pub fn supported(fs: string) -> bool is
    return fs == "btrfs" || fs == "ext4"
end

pub fn is_root_config(c: config::Config) -> bool is
    return config::s(c, "source") == "/"
end

;; /dev/nvme0n1p2[/@]  ->  /dev/nvme0n1p2
pub fn root_device() -> string is
    let src: string = util::capture("findmnt -no SOURCE / | head -1")
    let br: int = string_find(src, "[")
    if br < 0 is return src end
    return string_slice(src, 0, br)
end

pub fn device_of(path: string) -> string is
    let src: string = util::capture("findmnt -no SOURCE -T " + util::sq(path) + " 2>/dev/null | head -1")
    let br: int = string_find(src, "[")
    if br < 0 is return src end
    return string_slice(src, 0, br)
end

;; btrfs: name of the subvolume mounted at /, e.g. "@". "" when / is the
;; top level (subvolid=5) itself — rollback by rename is impossible then.
pub fn root_subvol() -> string is
    let r: string = util::capture("findmnt -no FSROOT / | head -1")
    if r == "" || r == "/" is return "" end
    if string_starts_with(r, "/") is return string_slice(r, 1, string_len(r)) end
    return r
end

pub fn uuid_of(path: string) -> string is
    return util::capture("findmnt -no UUID -T " + util::sq(path) + " 2>/dev/null | head -1")
end

pub fn mount_of(path: string) -> string is
    return util::capture("findmnt -no TARGET -T " + util::sq(path) + " 2>/dev/null | head -1")
end

;; btrfs: is `path` the root of a subvolume (inode 256)?  Snapshots need that.
pub fn is_subvolume(path: string) -> bool is
    return util::capture("stat -c %i " + util::sq(path) + " 2>/dev/null") == "256"
end

;; ── the btrfs top level (subvolid=5), needed for rollback and root cleanup ───

pub fn top_path() -> string is
    return "/run/hackeros-snapshots/top"
end

;; Returns the mount point, or "" when it cannot be mounted.
pub fn mount_top() -> string is
    let top: string = top_path()
    util::mkdir_p(top)
    if util::is_mountpoint(top) is return top end
    if util::run("mount -o subvolid=5 " + util::sq(root_device()) + " " + util::sq(top) + " 2>/dev/null") != 0 is return "" end
    return top
end

pub fn umount_top() is
    if util::is_mountpoint(top_path()) is
        util::run("umount " + util::sq(top_path()) + " 2>/dev/null")
    end
end

;; ── the running kernel ───────────────────────────────────────────────────────

pub fn running_kver() -> string is
    return util::capture("uname -r")
end
