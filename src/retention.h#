fn group_of(t: string) -> string is
    if t == "pre" || t == "post" is return "prepost" end
    return t
end

fn limit_of(c: config::Config, group: string) -> int is
    if group == "boot"     is return config::n(c, "keep_boot") end
    if group == "timeline" is return config::n(c, "keep_timeline") end
    if group == "prepost"  is return config::n(c, "keep_prepost") * 2 end
    if group == "manual"   is return config::n(c, "keep_manual") end
    return 0   ;; "rollback" safety snapshots are only removed by age / space
end

;; the newest keep_min ids
fn protected_ids(c: config::Config, list: [store::Snap]) -> [int] is
    let mut protect: [int] = []
    let mut k: int = array_len(list) - 1
    while k >= 0 && array_len(protect) < config::n(c, "keep_min") is
        protect = array_push(protect, list[k].sn_id)
        k -= 1
    end
    return protect
end

;; ids that would be deleted, ascending.
pub fn victims(c: config::Config, deep: bool) -> [int] is
    let list: [store::Snap] = store::all(c)
    let n: int = array_len(list)
    let mut doomed: [int] = []

    ;; 1) count limits, walking newest → oldest per group
    let groups: [string] = ["boot", "timeline", "prepost", "manual", "rollback"]
    let mut g: int = 0
    while g < array_len(groups) is
        let limit: int = limit_of(c, groups[g])
        let mut seen: int = 0
        let mut i: int = n - 1
        while i >= 0 is
            if group_of(list[i].sn_type) == groups[g] is
                seen += 1
                if limit > 0 && seen > limit && !list[i].sn_pinned is
                    doomed = array_push(doomed, list[i].sn_id)
                end
            end
            i -= 1
        end
        g += 1
    end

    ;; 2) age limit
    let max_days: int = config::n(c, "max_age_days")
    if max_days > 0 is
        let cutoff: int = util::now_epoch() - max_days * 86400
        let mut j: int = 0
        while j < n is
            if list[j].sn_epoch > 0 && list[j].sn_epoch < cutoff && !list[j].sn_pinned && !util::has_int(doomed, list[j].sn_id) is
                doomed = array_push(doomed, list[j].sn_id)
            end
            j += 1
        end
    end

    let protect: [int] = protected_ids(c, list)

    ;; 3) space limit — oldest first, counting what the rules above already free
    let limit_mb: int = usage::limit_mb(c)
    if limit_mb > 0 is
        let usg: [usage::Use] = usage::per_snapshot(c, deep)
        if array_len(usg) > 0 is
            let mut freed: int = 0
            let mut d: int = 0
            while d < array_len(doomed) is
                freed += usage::mb_of(usg, doomed[d])
                d += 1
            end
            let mut m: int = 0
            while m < n && usage::sum(usg) - freed > limit_mb is
                let id: int = list[m].sn_id
                if !list[m].sn_pinned && !util::has_int(doomed, id) && !util::has_int(protect, id) is
                    doomed = array_push(doomed, id)
                    freed += usage::mb_of(usg, id)
                end
                m += 1
            end
        end
    end

    let mut out: [int] = []
    let mut q: int = 0
    while q < n is
        let id2: int = list[q].sn_id
        if util::has_int(doomed, id2) && !util::has_int(protect, id2) is
            out = array_push(out, id2)
        end
        q += 1
    end
    return out
end

;; Returns how many snapshots were (or, with dry_run, would be) deleted.
;; Also removes old rollback roots (btrfs root config).
pub fn cleanup(c: config::Config, dry_run: bool, deep: bool) -> int is
    let list: [int] = victims(c, deep)
    let mut done: int = 0
    let mut i: int = 0
    while i < array_len(list) is
        let id: int = list[i]
        i += 1
        if dry_run is
            ui::line("would delete #" + to_string(id) + "  (" + c.cf_name + ")")
            done += 1
        else is
            if snap::delete(c, id, false) is
                notify::info("deleted old snapshot #" + to_string(id) + " of config " + c.cf_name)
                done += 1
            end
        end
    end
    done += roots::prune(c, dry_run)
    return done
end

;; The disk is (almost) full: delete the oldest unpinned snapshots — never the newest
;; keep_min — until min_free_percent is free again. Returns true when there is enough
;; free space afterwards.
pub fn emergency(c: config::Config) -> bool is
    let need: int = config::n(c, "min_free_percent")
    if need <= 0 || usage::free_percent(c) >= need is return true end
    let list: [store::Snap] = store::all(c)
    let protect: [int] = protected_ids(c, list)
    let mut i: int = 0
    while i < array_len(list) is
        let s: store::Snap = list[i]
        i += 1
        if s.sn_pinned || util::has_int(protect, s.sn_id) is continue end
        if snap::delete(c, s.sn_id, false) is
            notify::warn("low disk space: deleted snapshot #" + to_string(s.sn_id) + " of config " + c.cf_name)
            if usage::free_percent(c) >= need is return true end
        end
    end
    return usage::free_percent(c) >= need
end
