extern static [c] is
    fn system(cmd: string) -> int
end

;; data files (awk scripts) — installed under /usr/lib/hackeros-snapshots, or ./data in the repo
pub fn awk_file(name: string) -> string is
    let installed: string = "/usr/lib/hackeros-snapshots/awk/" + name
    if file_exists(installed) is return installed end
    return "data/awk/" + name
end

;; ── Shell ────────────────────────────────────────────────────────────────────

pub fn run(cmd: string) -> int is
    return system(cmd)
end

;; stdout of a command, trimmed.
pub fn capture(cmd: string) -> string is
    return string_trim(shell(cmd))
end

;; POSIX single-quote a value so it is safe inside a shell command line.
pub fn sq(s: string) -> string is
    return "'" + string_replace(s, "'", "'\\''") + "'"
end

pub fn tool_exists(name: string) -> bool is
    return system("command -v " + sq(name) + " >/dev/null 2>&1") == 0
end

pub fn is_root() -> bool is
    return capture("id -u") == "0"
end

pub fn mkdir_p(dir: string) -> int is
    return system("mkdir -p " + sq(dir))
end

pub fn is_mountpoint(path: string) -> bool is
    return system("mountpoint -q " + sq(path) + " 2>/dev/null") == 0
end

;; ── Strings / numbers ────────────────────────────────────────────────────────

pub fn is_num(s: string) -> bool is
    let n: int = string_len(s)
    if n == 0 || n > 9 is return false end
    let digits: string = "0123456789"
    let mut i: int = 0
    while i < n is
        if !string_contains(digits, string_at(s, i)) is return false end
        i += 1
    end
    return true
end

pub fn to_int_or(s: string, fallback: int) -> int is
    let t: string = string_trim(s)
    if is_num(t) is return to_int(t) end
    return fallback
end

pub fn parse_bool(v: string, fallback: bool) -> bool is
    let t: string = string_lower(string_trim(v))
    if t == "true" || t == "yes" || t == "1" || t == "on" is return true end
    if t == "false" || t == "no" || t == "0" || t == "off" is return false end
    return fallback
end

pub fn bool_str(b: bool) -> string is
    if b is return "true" end
    return "false"
end

pub fn one_line(s: string) -> string is
    let a: string = string_replace(s, "\n", " ")
    let b: string = string_replace(a, "\r", " ")
    return string_replace(b, "\t", " ")
end

pub fn has_int(items: [int], needle: int) -> bool is
    let mut i: int = 0
    while i < array_len(items) is
        if items[i] == needle is return true end
        i += 1
    end
    return false
end

pub fn pad_right(s: string, n: int) -> string is
    let mut out: string = s
    while string_len(out) < n is out = out + " " end
    return out
end

;; "/a/b/c" -> "/a/b"
pub fn dirname_of(path: string) -> string is
    let mut cut: int = -1
    let mut i: int = 0
    while i < string_len(path) is
        if string_at(path, i) == "/" is cut = i end
        i += 1
    end
    if cut < 0 is return "." end
    if cut == 0 is return "/" end
    return string_slice(path, 0, cut)
end

;; "/a/b/c" -> "c"
pub fn basename_of(path: string) -> string is
    let mut cut: int = -1
    let mut i: int = 0
    while i < string_len(path) is
        if string_at(path, i) == "/" is cut = i end
        i += 1
    end
    if cut < 0 is return path end
    return string_slice(path, cut + 1, string_len(path))
end

;; stdout of a command split into lines ([] when empty).
pub fn capture_lines(cmd: string) -> [string] is
    let out: string = capture(cmd)
    if out == "" is
        let none: [string] = []
        return none
    end
    return string_split(out, "\n")
end

pub fn uid() -> int is
    return to_int_or(capture("id -u"), 0)
end

;; comma separated list → trimmed non-empty items
pub fn csv(s: string) -> [string] is
    let mut out: [string] = []
    let parts: [string] = string_split(s, ",")
    let mut i: int = 0
    while i < array_len(parts) is
        let p: string = string_trim(parts[i])
        if p != "" is out = array_push(out, p) end
        i += 1
    end
    return out
end

pub fn has_str(items: [string], needle: string) -> bool is
    let mut i: int = 0
    while i < array_len(items) is
        if items[i] == needle is return true end
        i += 1
    end
    return false
end

;; ── Time ─────────────────────────────────────────────────────────────────────

pub fn now_epoch() -> int is
    return to_int_or(capture("date +%s"), 0)
end

pub fn fmt_epoch(e: int) -> string is
    return capture("date -d @" + to_string(e) + " '+%Y-%m-%d %H:%M'")
end

pub fn stamp() -> string is
    return capture("date '+%Y%m%d-%H%M%S'")
end

;; ── Files ────────────────────────────────────────────────────────────────────

pub fn read_or(path: string, fallback: string) -> string is
    if !file_exists(path) is return fallback end
    return file_read(path)
end

pub fn write_file(path: string, text: string) -> int is
    file_write(path, text)
    return 0
end

;; ── Lock (one mutating operation at a time) ──────────────────────────────────
;; mkdir is atomic. The lock lives in /run, so a crash never outlives a reboot.

pub fn lock_path() -> string is
    return "/run/hackeros-snapshots.lock"
end

pub fn lock_acquire() -> bool is
    let mut tries: int = 0
    while tries < 60 is
        if system("mkdir " + sq(lock_path()) + " 2>/dev/null") == 0 is return true end
        tries += 1
        system("sleep 1")
    end
    return false
end

pub fn lock_release() is
    system("rmdir " + sq(lock_path()) + " 2>/dev/null")
end

;; ── Prompt ───────────────────────────────────────────────────────────────────

pub fn confirm(question: string) -> bool is
    write("  " + question + " [y/N] ")
    let a: string = string_lower(capture("read -r a; echo \"$a\""))
    return a == "y" || a == "yes" || a == "t" || a == "tak"
end
