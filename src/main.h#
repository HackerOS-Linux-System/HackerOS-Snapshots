extern static [c] is
    fn exit(code: int)
end

fn arg_at(arr: [string], i: int) -> string is
    if i < array_len(arr) is return arr[i] end
    return ""
end

fn main() is
    let args: [string] = env::args()
    let argc: int = array_len(args)

    let mut cmd:  string   = ""
    let mut pos:  [string] = []
    let mut o: cli::Opts = cli::Opts {
        op_desc: "", op_type: "", op_config: "", op_source: "", op_to: "", op_fs: "", op_method: "",
        op_pre: 0,
        op_porcelain: false, op_yes: false, op_force: false, op_dry: false, op_offline: false,
        op_all: false, op_plan: false, op_nobackup: false, op_delete: false, op_deep: false, op_usage: false
    }

    let mut i: int = 1
    while i < argc is
        let a: string = args[i]
        match a is
            "--version" | "-V" => is
                write("hackeros-snapshots " + cli::version())
                exit(0)
            end
            "--help" | "-h" => is
                cli::print_help()
                exit(0)
            end
            "--desc" | "-d"     => is
                i += 1
                o.op_desc = arg_at(args, i)
            end
            "--type" | "-t"     => is
                i += 1
                o.op_type = arg_at(args, i)
            end
            "--config" | "-c"   => is
                i += 1
                o.op_config = arg_at(args, i)
            end
            "--source"          => is
                i += 1
                o.op_source = arg_at(args, i)
            end
            "--to"              => is
                i += 1
                o.op_to = arg_at(args, i)
            end
            "--fs"              => is
                i += 1
                o.op_fs = arg_at(args, i)
            end
            "--method"          => is
                i += 1
                o.op_method = arg_at(args, i)
            end
            "--pre"             => is
                i += 1
                o.op_pre = util::to_int_or(arg_at(args, i), 0)
            end
            "--porcelain"        => is o.op_porcelain = true end
            "--yes" | "-y"       => is o.op_yes = true end
            "--force" | "-f"     => is o.op_force = true end
            "--dry-run" | "-n"   => is o.op_dry = true end
            "--offline"          => is o.op_offline = true end
            "--all"              => is o.op_all = true end
            "--plan"             => is o.op_plan = true end
            "--no-backup"        => is o.op_nobackup = true end
            "--delete"           => is o.op_delete = true end
            "--deep"             => is o.op_deep = true end
            "--usage"            => is o.op_usage = true end
            _ => is
                if string_starts_with(a, "-") && string_len(a) > 1 is
                    ui::fail("unknown option '" + a + "'   (hackeros-snapshots --help)")
                    exit(2)
                else if cmd == "" is
                    cmd = a
                else is
                    pos = array_push(pos, a)
                end
            end
        end
        i += 1
    end

    if cmd == "" is
        cli::print_help()
        exit(0)
    end
    exit(cli::dispatch(cmd, pos, o))
end
