fn tab() -> string is
    return "$(printf '\\t')"
end

fn sort_cmd() -> string is
    return "LC_ALL=C sort -t \"" + tab() + "\" -k2"
end

pub fn tree_of(c: config::Config, n: int) -> string is
    if n == 0 is return config::s(c, "source") end
    return store::snap_path(c, n)
end

;; drop everything below an excluded path (btrfs snapshots have those cut out)
fn drop_excluded(c: config::Config, lines: [string]) -> [string] is
    let ex: [string] = paths::exclude_list(c)
    if array_len(ex) == 0 is return lines end
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(lines) is
        let f: [string] = string_split(lines[i], "\t")
        let mut skip: bool = false
        if array_len(f) >= 2 is
            let mut k: int = 0
            while k < array_len(ex) is
                if f[1] == ex[k] || string_starts_with(f[1], ex[k] + "/") is skip = true end
                k += 1
            end
        end
        if !skip is out = array_push(out, lines[i]) end
        i += 1
    end
    return out
end

fn invert(lines: [string]) -> [string] is
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(lines) is
        let ln: string = lines[i]
        i += 1
        if string_starts_with(ln, "+\t") is
            out = array_push(out, "-\t" + string_slice(ln, 2, string_len(ln)))
        else if string_starts_with(ln, "-\t") is
            out = array_push(out, "+\t" + string_slice(ln, 2, string_len(ln)))
        else is
            out = array_push(out, ln)
        end
    end
    return out
end

fn rsync_changes(c: config::Config, a: int, b: int, deep: bool) -> [string] is
    if !util::tool_exists("rsync") is
        ui::fail("diff needs rsync (apt install rsync)")
        let none: [string] = []
        return none
    end
    let flags: string = if deep then "-rlptgoDHnx -c" else "-rlptgoDHnx"
    ;; dry run "new → old": what rsync would change in OLD is the difference
    let cmd: string = "rsync " + flags + " --delete -i --out-format='%i %n' " + paths::rsync_excludes(c) + util::sq(tree_of(c, b) + "/") + " " + util::sq(tree_of(c, a) + "/") + " 2>/dev/null | awk -f " + util::sq(util::awk_file("diff-rsync.awk")) + " | " + sort_cmd()
    return drop_excluded(c, util::capture_lines(cmd))
end

;; btrfs send needs both sides read-only; the live system gets a temporary snapshot.
;; Returns [] plus ok=false through the sentinel line "!" when send fails.
fn send_changes(c: config::Config, a: int, b: int) -> [string] is
    let mut lo: int = a
    let mut hi: int = b
    let mut swapped: bool = false
    if b != 0 && a > b is
        lo = b
        hi = a
        swapped = true
    end
    let mut tmp: string = ""
    let mut hi_path: string = tree_of(c, hi)
    if hi == 0 is
        tmp = store::store_dir(c) + "/.diff-live-" + util::stamp()
        if util::run("btrfs subvolume snapshot -r " + util::sq(config::s(c, "source")) + " " + util::sq(tmp) + " >/dev/null 2>&1") != 0 is
            return ["!"]
        end
        hi_path = tmp
    end
    util::mkdir_p("/run/hackeros-snapshots")
    let stream: string = "/run/hackeros-snapshots/diff-" + util::stamp() + ".stream"
    let rc: int = util::run("btrfs send --no-data -p " + util::sq(store::snap_path(c, lo)) + " " + util::sq(hi_path) + " -f " + util::sq(stream) + " >/dev/null 2>&1")
    if tmp != "" is util::run("btrfs subvolume delete " + util::sq(tmp) + " >/dev/null 2>&1") end
    if rc != 0 is
        util::run("rm -f " + util::sq(stream))
        return ["!"]
    end
    let out: [string] = util::capture_lines("btrfs receive --dump -f " + util::sq(stream) + " 2>/dev/null | awk -f " + util::sq(util::awk_file("diff-dump.awk")) + " | " + sort_cmd())
    util::run("rm -f " + util::sq(stream))
    let cleaned: [string] = drop_excluded(c, out)
    if swapped is return invert(cleaned) end
    return cleaned
end

;; method: auto | send | rsync.   deep = compare contents with checksums (rsync only, slow).
pub fn changes(c: config::Config, a: int, b: int, method: string, deep: bool) -> [string] is
    let fs: string = fsinfo::effective(c)
    let mut m: string = method
    if m == "" || m == "auto" is
        m = if fs == "btrfs" && util::is_root() && !deep then "send" else "rsync"
    end
    if m == "send" is
        if fs != "btrfs" || a == 0 is
            ui::fail("the send method needs two btrfs snapshots (from the older one, or the live system)")
            let none: [string] = []
            return none
        end
        let r: [string] = send_changes(c, a, b)
        if !(array_len(r) == 1 && r[0] == "!") is return r end
        ui::warn("btrfs send failed — falling back to an rsync comparison")
    end
    return rsync_changes(c, a, b, deep)
end

;; ── browse ───────────────────────────────────────────────────────────────────

;; Lines "type TAB size TAB name" (type: d dir, f file, l link), directories first.
pub fn browse(c: config::Config, id: int, rel: string) -> [string] is
    let none: [string] = []
    if !paths::safe_rel(rel) is return none end
    let dir: string = store::snap_path(c, id) + (if rel == "/" then "" else rel)
    if !dir_exists(dir) is return none end
    let cmd: string = "find " + util::sq(dir) + " -mindepth 1 -maxdepth 1 -printf '%y\\t%s\\t%f\\n' 2>/dev/null | LC_ALL=C sort -t \"" + tab() + "\" -k1,1 -k3"
    return util::capture_lines(cmd)
end

;; ── restore ──────────────────────────────────────────────────────────────────

fn backup_root() -> string is
    return "/var/lib/hackeros-snapshots/restore-backups"
end

fn trim_slash(p: string) -> string is
    if p != "/" && string_ends_with(p, "/") is return string_slice(p, 0, string_len(p) - 1) end
    return p
end

;; Restores `items` (absolute paths inside the source, e.g. /etc/fstab) from snapshot `id`.
;;   to      ""  = back to their original place;  otherwise extract below that directory
;;   backup  in-place only: files that get overwritten / deleted are kept under
;;           /var/lib/hackeros-snapshots/restore-backups/<time>/
;;   del     directories: also delete files that are not in the snapshot (exact copy)
pub fn restore(c: config::Config, id: int, items: [string], to: string, backup: bool, del: bool) -> int is
    if !store::exists(c, id) is
        ui::fail("no snapshot #" + to_string(id))
        return 1
    end
    if to == "" && !util::is_root() is
        ui::fail("restoring in place needs root (or use --to DIR)")
        return 1
    end
    if array_len(items) == 0 is
        ui::fail("nothing to restore — give one or more paths, e.g. /etc/fstab")
        return 2
    end
    let bd: string = backup_root() + "/" + c.cf_name + "-" + to_string(id) + "-" + util::stamp()
    let have_rsync: bool = util::tool_exists("rsync")
    let mut failed: int = 0
    let mut i: int = 0
    while i < array_len(items) is
        let p: string = trim_slash(items[i])
        i += 1
        if !paths::safe_rel(p) || p == "/" is
            ui::fail("'" + p + "': give an absolute path inside the snapshot (the whole system: use rollback)")
            failed += 1
            continue
        end
        let src: string = store::snap_path(c, id) + p
        let is_dir: bool = dir_exists(src)
        if !is_dir && !file_exists(src) is
            ui::fail(p + " does not exist in snapshot #" + to_string(id))
            failed += 1
            continue
        end
        let base: string = if to != "" then trim_slash(to) else trim_slash(config::s(c, "source"))
        let dest: string = (if base == "/" then "" else base) + p
        util::mkdir_p(util::dirname_of(dest))
        let mut rc: int = 1
        if have_rsync is
            let mut opts: string = "-aHAX "
            if is_dir && del is opts = opts + "--delete " end
            if to == "" && backup is
                opts = opts + "--backup --backup-dir=" + util::sq(bd + (if is_dir then p else util::dirname_of(p))) + " "
            end
            if is_dir is
                rc = util::run("rsync " + opts + util::sq(src + "/") + " " + util::sq(dest + "/"))
            else is
                rc = util::run("rsync " + opts + util::sq(src) + " " + util::sq(dest))
            end
        else is
            if to == "" && backup && file_exists(dest) is
                util::run("cp -a -- " + util::sq(dest) + " " + util::sq(dest + ".hsnap-old-" + util::stamp()))
            end
            rc = util::run("cp -a --reflink=auto -- " + util::sq(src) + " " + util::sq(util::dirname_of(dest) + "/"))
        end
        if rc == 0 || rc == 24 is
            ui::ok(p + "  ←  snapshot #" + to_string(id) + (if to != "" then "  →  " + dest else ""))
        else is
            ui::fail("restoring " + p + " failed")
            failed += 1
        end
    end
    if to == "" && backup && have_rsync && dir_exists(bd) is
        ui::note("overwritten files were kept in " + bd)
    end
    if failed == 0 is
        notify::info("restored " + to_string(array_len(items)) + " path(s) from snapshot #" + to_string(id) + " of config " + c.cf_name)
        return 0
    end
    return 1
end
