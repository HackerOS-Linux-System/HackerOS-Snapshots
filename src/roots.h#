mod util
mod ui
mod config
mod fsinfo
mod notify

pub struct Root is
    pub rt_name:    string
    pub rt_epoch:   int
    pub rt_running: bool
end

fn stamp_epoch(stamp: string) -> int is
    let d: string = util::capture("echo " + util::sq(stamp) + " | sed -E 's/^(....)(..)(..)-(..)(..)(..)$/\\1-\\2-\\3 \\4:\\5:\\6/'")
    if d == "" is return 0 end
    return util::to_int_or(util::capture("date -d " + util::sq(d) + " +%s 2>/dev/null"), 0)
end

fn stamp_of(name: string) -> string is
    let at: int = string_find(name, ".before-rollback-")
    if at < 0 is return "" end
    return string_slice(name, at + 17, string_len(name))
end

;; Oldest first. Leaves the btrfs top level MOUNTED (callers unmount via fsinfo::umount_top).
pub fn list() -> [Root] is
    let mut out: [Root] = []
    let top: string = fsinfo::mount_top()
    if top == "" is return out end
    let names: [string] = util::capture_lines("ls -1 " + util::sq(top) + " 2>/dev/null | grep '\\.before-rollback-[0-9]*-[0-9]*$' | sort")
    let running: string = fsinfo::root_subvol()
    let mut i: int = 0
    while i < array_len(names) is
        out = array_push(out, Root { rt_name: names[i], rt_epoch: stamp_epoch(stamp_of(names[i])), rt_running: names[i] == running })
        i += 1
    end
    return out
end

fn delete_root(name: string) -> bool is
    let top: string = fsinfo::top_path()
    return util::run("btrfs subvolume delete -R -c " + util::sq(top + "/" + name) + " >/dev/null 2>&1") == 0
end

;; Returns how many old roots were (or, with dry_run, would be) deleted.
pub fn prune(c: config::Config, dry_run: bool) -> int is
    if !fsinfo::is_root_config(c) || fsinfo::effective(c) != "btrfs" is return 0 end
    if !util::is_root() is return 0 end
    let list: [Root] = list()
    let n: int = array_len(list)
    let keep: int = config::n(c, "keep_rollback_roots")
    let days: int = config::n(c, "rollback_root_days")
    let now: int = util::now_epoch()
    let mut done: int = 0
    let mut i: int = 0
    while i < n is
        let r: Root = list[i]
        let rank: int = n - 1 - i             ;; 0 = newest
        i += 1
        if r.rt_running is continue end
        let too_old: bool = days > 0 && r.rt_epoch > 0 && now - r.rt_epoch > days * 86400
        let too_many: bool = keep > 0 && rank >= keep
        if too_old || too_many is
            if dry_run is
                ui::line("would delete old root " + r.rt_name)
                done += 1
            else if delete_root(r.rt_name) is
                notify::info("deleted old root subvolume " + r.rt_name)
                done += 1
            else is
                notify::warn("could not delete old root subvolume " + r.rt_name)
            end
        end
    end
    fsinfo::umount_top()
    return done
end

pub fn delete_named(name: string) -> bool is
    if stamp_of(name) == "" is
        ui::fail("'" + name + "' is not a rollback backup (expected  <root>.before-rollback-<date>)")
        return false
    end
    if name == fsinfo::root_subvol() is
        ui::fail(name + " is the root that is still mounted — reboot first")
        return false
    end
    let list: [Root] = list()
    let mut found: bool = false
    let mut i: int = 0
    while i < array_len(list) is
        if list[i].rt_name == name is found = true end
        i += 1
    end
    let ok: bool = found && delete_root(name)
    fsinfo::umount_top()
    if !found is ui::fail("no such old root: " + name) end
    return ok
end
