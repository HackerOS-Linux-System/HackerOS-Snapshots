mod util
mod config

pub struct Snap is
    pub sn_id:     int
    pub sn_type:   string   ;; manual | boot | timeline | pre | post | rollback
    pub sn_desc:   string
    pub sn_epoch:  int
    pub sn_pinned: bool
    pub sn_pre:    int      ;; post → id of its pre snapshot, else 0
    pub sn_fs:     string
    pub sn_kver:   string   ;; kernel that was running when the snapshot was taken
end

pub fn store_dir(c: config::Config) -> string is
    return config::s(c, "store")
end

pub fn dir_of(c: config::Config, id: int) -> string is
    return store_dir(c) + "/" + to_string(id)
end

pub fn snap_path(c: config::Config, id: int) -> string is
    return dir_of(c, id) + "/snapshot"
end

fn info_path(c: config::Config, id: int) -> string is
    return dir_of(c, id) + "/info"
end

pub fn exists(c: config::Config, id: int) -> bool is
    return file_exists(info_path(c, id))
end

fn field(text: string, key: string, fallback: string) -> string is
    let lines: [string] = string_split(text, "\n")
    let mut i: int = 0
    while i < array_len(lines) is
        let ln: string = lines[i]
        i += 1
        let eq: int = string_find(ln, "=")
        if eq > 0 && string_slice(ln, 0, eq) == key is
            return string_trim(string_slice(ln, eq + 1, string_len(ln)))
        end
    end
    return fallback
end

pub fn read(c: config::Config, id: int) -> Snap is
    let text: string = util::read_or(info_path(c, id), "")
    return Snap {
        sn_id: id,
        sn_type: field(text, "type", "manual"),
        sn_desc: field(text, "desc", ""),
        sn_epoch: util::to_int_or(field(text, "created", "0"), 0),
        sn_pinned: util::parse_bool(field(text, "pinned", "false"), false),
        sn_pre: util::to_int_or(field(text, "pre", "0"), 0),
        sn_fs: field(text, "fs", ""),
        sn_kver: field(text, "kver", "")
    }
end

pub fn write(c: config::Config, s: Snap) -> int is
    let mut t: string = ""
    t = t + "id=" + to_string(s.sn_id) + "\n"
    t = t + "type=" + s.sn_type + "\n"
    t = t + "desc=" + util::one_line(s.sn_desc) + "\n"
    t = t + "created=" + to_string(s.sn_epoch) + "\n"
    t = t + "pinned=" + util::bool_str(s.sn_pinned) + "\n"
    t = t + "pre=" + to_string(s.sn_pre) + "\n"
    t = t + "fs=" + s.sn_fs + "\n"
    t = t + "kver=" + s.sn_kver + "\n"
    file_write(info_path(c, s.sn_id), t)
    util::run("chmod 644 " + util::sq(info_path(c, s.sn_id)))
    return 0
end

;; All ids in the store, ascending.
pub fn ids(c: config::Config) -> [int] is
    let mut out: [int] = []
    if !dir_exists(store_dir(c)) is return out end
    let names: [string] = string_split(util::capture("ls -1 " + util::sq(store_dir(c)) + " 2>/dev/null | sort -n"), "\n")
    let mut i: int = 0
    while i < array_len(names) is
        let n: string = string_trim(names[i])
        i += 1
        if util::is_num(n) && exists(c, to_int(n)) is
            out = array_push(out, to_int(n))
        end
    end
    return out
end

pub fn all(c: config::Config) -> [Snap] is
    let list: [int] = ids(c)
    let mut out: [Snap] = []
    let mut i: int = 0
    while i < array_len(list) is
        out = array_push(out, read(c, list[i]))
        i += 1
    end
    return out
end

pub fn next_id(c: config::Config) -> int is
    let list: [int] = ids(c)
    let n: int = array_len(list)
    let mut top: int = 0
    if n > 0 is top = list[n - 1] end
    ;; also skip directories left behind by a failed create
    let raw: string = util::capture("ls -1 " + util::sq(store_dir(c)) + " 2>/dev/null | sort -n | tail -1")
    let raw_top: int = util::to_int_or(raw, 0)
    if raw_top > top is top = raw_top end
    return top + 1
end

;; Newest snapshot of a type ("" = any); 0 when none.
pub fn latest_id(c: config::Config, stype: string) -> int is
    let list: [Snap] = all(c)
    let mut i: int = array_len(list) - 1
    while i >= 0 is
        if stype == "" || list[i].sn_type == stype is return list[i].sn_id end
        i -= 1
    end
    return 0
end
