mod util
mod config
mod fsinfo
mod store

pub struct Use is
    pub us_id: int
    pub us_mb: int
end

fn probe_path(c: config::Config) -> string is
    let st: string = store::store_dir(c)
    if dir_exists(st) is return st end
    return config::s(c, "source")
end

pub fn total_mb(c: config::Config) -> int is
    return util::to_int_or(util::capture("df -m --output=size " + util::sq(probe_path(c)) + " 2>/dev/null | tail -1"), 0)
end

pub fn avail_mb(c: config::Config) -> int is
    return util::to_int_or(util::capture("df -m --output=avail " + util::sq(probe_path(c)) + " 2>/dev/null | tail -1"), 0)
end

;; 0..100, 100 when unknown (never block on a failed df)
pub fn free_percent(c: config::Config) -> int is
    let t: int = total_mb(c)
    if t <= 0 is return 100 end
    return avail_mb(c) * 100 / t
end

pub fn limit_mb(c: config::Config) -> int is
    let pct: int = config::n(c, "max_usage_percent")
    if pct <= 0 is return 0 end
    return total_mb(c) * pct / 100
end

;; ── btrfs qgroups ────────────────────────────────────────────────────────────

pub fn qgroups_enabled(c: config::Config) -> bool is
    return util::run("btrfs qgroup show " + util::sq(probe_path(c)) + " >/dev/null 2>&1") == 0
end

pub fn enable_qgroups(c: config::Config) -> bool is
    let mnt: string = fsinfo::mount_of(probe_path(c))
    if mnt == "" is return false end
    if qgroups_enabled(c) is return true end
    return util::run("btrfs quota enable " + util::sq(mnt) + " 2>/dev/null") == 0
end

fn qgroup_mb(qlines: [string], subvol_id: string) -> int is
    let pre: string = "0/" + subvol_id + " "
    let mut i: int = 0
    while i < array_len(qlines) is
        if string_starts_with(qlines[i], pre) is
            return util::to_int_or(string_slice(qlines[i], string_len(pre), string_len(qlines[i])), 0)
        end
        i += 1
    end
    return 0
end

fn per_snapshot_btrfs(c: config::Config) -> [Use] is
    let mut out: [Use] = []
    if !qgroups_enabled(c) is return out end
    let st: string = util::sq(store::store_dir(c))
    let mapping: [string] = util::capture_lines("for d in " + st + "/*/snapshot; do [ -d \"$d\" ] || continue; i=$(basename \"$(dirname \"$d\")\"); s=$(btrfs subvolume show \"$d\" 2>/dev/null | sed -n 's/^[[:space:]]*Subvolume ID:[[:space:]]*//p'); echo \"$i $s\"; done")
    let q: [string] = util::capture_lines("btrfs qgroup show --raw " + st + " 2>/dev/null | awk -f " + util::sq(util::awk_file("qgroup.awk")))
    let mut i: int = 0
    while i < array_len(mapping) is
        let parts: [string] = string_split(mapping[i], " ")
        i += 1
        if array_len(parts) >= 2 && util::is_num(parts[0]) && util::is_num(parts[1]) is
            out = array_push(out, Use { us_id: to_int(parts[0]), us_mb: qgroup_mb(q, parts[1]) })
        end
    end
    return out
end

fn per_snapshot_tree(c: config::Config) -> [Use] is
    let mut out: [Use] = []
    let ids: [int] = store::ids(c)
    if array_len(ids) == 0 is return out end
    let mut args: string = ""
    let mut i: int = array_len(ids) - 1
    while i >= 0 is
        args = args + util::sq(store::snap_path(c, ids[i])) + " "
        i -= 1
    end
    let lines: [string] = util::capture_lines("nice -n 19 ionice -c3 du -sm " + args + " 2>/dev/null")
    let pre: string = store::store_dir(c) + "/"
    let mut k: int = 0
    while k < array_len(lines) is
        let f: [string] = string_split(lines[k], "\t")
        k += 1
        if array_len(f) >= 2 && string_starts_with(f[1], pre) is
            let rest: string = string_slice(f[1], string_len(pre), string_len(f[1]))
            let slash: int = string_find(rest, "/")
            if slash > 0 && util::is_num(string_slice(rest, 0, slash)) is
                out = array_push(out, Use { us_id: to_int(string_slice(rest, 0, slash)), us_mb: util::to_int_or(f[0], 0) })
            end
        end
    end
    return out
end

;; [] when the numbers are not available (btrfs without qgroups, ext4 without `deep`).
pub fn per_snapshot(c: config::Config, deep: bool) -> [Use] is
    let fs: string = fsinfo::effective(c)
    if fs == "btrfs" is return per_snapshot_btrfs(c) end
    if fs == "ext4" && deep is return per_snapshot_tree(c) end
    let none: [Use] = []
    return none
end

pub fn sum(list: [Use]) -> int is
    let mut t: int = 0
    let mut i: int = 0
    while i < array_len(list) is
        t += list[i].us_mb
        i += 1
    end
    return t
end

pub fn mb_of(list: [Use], id: int) -> int is
    let mut i: int = 0
    while i < array_len(list) is
        if list[i].us_id == id is return list[i].us_mb end
        i += 1
    end
    return 0
end

pub fn fmt_mb(mb: int) -> string is
    if mb >= 10240 is return to_string(mb / 1024) + " GiB" end
    if mb >= 1024 is return to_string(mb / 1024) + "." + to_string((mb % 1024) * 10 / 1024) + " GiB" end
    return to_string(mb) + " MiB"
end
