fn status_one(c: config::Config) is
    let fs: string = fsinfo::effective(c)
    let list: [store::Snap] = store::all(c)
    ui::heading("config '" + c.cf_name + "'   " + (if config::b(c, "enabled") then "" else "(disabled)"))
    ui::line(util::pad_right("filesystem", 18) + fs + (if fsinfo::supported(fs) then "" else "   (unsupported)"))
    ui::line(util::pad_right("source", 18) + config::s(c, "source"))
    ui::line(util::pad_right("store", 18) + config::s(c, "store") + (if dir_exists(config::s(c, "store")) then "" else "   (missing — run: init -c " + c.cf_name + ")"))
    ui::line(util::pad_right("snapshots", 18) + to_string(array_len(list)) + "   " + to_string(usage::free_percent(c)) + "% free")
    ui::line(util::pad_right("on boot", 18) + "snapshot=" + config::s(c, "snapshot_on_boot") + "  cleanup=" + config::s(c, "cleanup_on_boot"))
    ui::line(util::pad_right("timeline", 18) + config::s(c, "timeline") + "  every " + config::s(c, "timeline_minutes") + " min")
    ui::line(util::pad_right("keep", 18) + "boot=" + config::s(c, "keep_boot") + " timeline=" + config::s(c, "keep_timeline") + " prepost=" + config::s(c, "keep_prepost") + " manual=" + config::s(c, "keep_manual") + "  (0 = unlimited)")
    ui::line(util::pad_right("limits", 18) + "age=" + config::s(c, "max_age_days") + "d  disk=" + config::s(c, "max_usage_percent") + "%  min free=" + config::s(c, "min_free_percent") + "%  keep_min=" + config::s(c, "keep_min"))
    if config::s(c, "excludes") != "" is ui::line(util::pad_right("excludes", 18) + config::s(c, "excludes")) end
    ui::line(util::pad_right("offsite", 18) + (if offsite::enabled(c) then config::s(c, "offsite_target") + "  (" + to_string(array_len(offsite::synced(c))) + " copied)" else "off"))
    ui::line(util::pad_right("would clean", 18) + to_string(array_len(retention::victims(c, false))) + " snapshot(s) on the next cleanup")
end

fn cmd_status() -> int is
    let root: config::Config = config::load()
    let state: string = notify::health_field("state", "unknown")
    ui::heading("HackerOS Snapshots " + version())
    ui::line(util::pad_right("service", 18) + state + (if notify::health_field("message", "") != "" then " — " + notify::health_field("message", "") else ""))
    ui::line(util::pad_right("GRUB entries", 18) + config::s(root, "grub") + "  (newest " + config::s(root, "grub_max") + ")")
    ui::line(util::pad_right("notifications", 18) + config::s(root, "notify_level") + "   log: " + config::s(root, "log_file"))
    if snap::reboot_pending() is ui::warn("a rollback is waiting for a reboot") end
    let names: [string] = config::names()
    let mut i: int = 0
    while i < array_len(names) is
        status_one(config::load_named(names[i]))
        i += 1
    end
    ui::blank()
    return 0
end

fn cmd_config(c: config::Config, pos: [string], o: Opts) -> int is
    let sub: string = if array_len(pos) > 0 then pos[0] else "show"
    if sub == "show" is
        write(config::render(c))
        return 0
    end
    if sub == "list" is
        let names: [string] = config::names()
        let mut i: int = 0
        while i < array_len(names) is
            if o.op_porcelain is
                let n: config::Config = config::load_named(names[i])
                write(names[i] + "\t" + config::s(n, "source") + "\t" + config::s(n, "enabled"))
            else is
                write(names[i])
            end
            i += 1
        end
        return 0
    end
    if sub == "keys" is
        let keys: [string] = config::key_names()
        let mut i: int = 0
        while i < array_len(keys) is
            write(keys[i])
            i += 1
        end
        return 0
    end
    if sub == "get" && array_len(pos) >= 2 is
        if !config::is_key(pos[1]) is
            ui::fail("unknown key '" + pos[1] + "'")
            return 1
        end
        write(config::get(c, pos[1]))
        return 0
    end
    if sub == "set" && array_len(pos) >= 3 is
        if !need_root() is return 1 end
        if !config::is_key(pos[1]) is
            ui::fail("unknown key '" + pos[1] + "'   (hackeros-snapshots config keys)")
            return 1
        end
        let n: config::Config = config::set(c, pos[1], pos[2])
        config::save(n)
        ui::ok(c.cf_name + ": " + pos[1] + " = " + config::get(config::load_named(c.cf_name), pos[1]))
        return 0
    end
    if sub == "apply" && array_len(pos) >= 2 is
        ;; several KEY=VALUE pairs in one go (one privileged call, one file write) — used by the GUI
        if !need_root() is return 1 end
        let mut n: config::Config = c
        let mut applied: int = 0
        let mut k: int = 1
        while k < array_len(pos) is
            let eq: int = string_find(pos[k], "=")
            let key: string = if eq > 0 then string_slice(pos[k], 0, eq) else ""
            k += 1
            if key == "" || !config::is_key(key) is
                ui::fail("bad KEY=VALUE pair: " + pos[k - 1])
                return 1
            end
            n = config::set(n, key, string_slice(pos[k - 1], eq + 1, string_len(pos[k - 1])))
            applied += 1
        end
        config::save(n)
        ui::ok(c.cf_name + ": " + to_string(applied) + " setting(s) saved")
        return 0
    end
    if sub == "create" && array_len(pos) >= 2 is
        if !need_root() is return 1 end
        let name: string = pos[1]
        if !config::valid_name(name) || name == "root" is
            ui::fail("config names: 1-32 chars of a-z 0-9 _ -  ('root' is taken)")
            return 1
        end
        if config::exists(name) is
            ui::fail("config '" + name + "' already exists")
            return 1
        end
        if o.op_source == "" || !dir_exists(o.op_source) is
            ui::fail("give an existing directory:  config create " + name + " --source /home")
            return 2
        end
        config::save(config::create(name, o.op_source))
        ui::ok("config '" + name + "' created (" + o.op_source + ") — now: sudo hackeros-snapshots -c " + name + " init")
        return 0
    end
    if sub == "delete" && array_len(pos) >= 2 is
        if !need_root() is return 1 end
        if pos[1] == "root" || !config::exists(pos[1]) is
            ui::fail("no such (deletable) config: " + pos[1])
            return 1
        end
        config::delete(pos[1])
        ui::ok("config '" + pos[1] + "' removed — its snapshots were NOT deleted (see the store directory)")
        return 0
    end
    ui::fail("usage: hackeros-snapshots config [show | get K | set K V | keys | list | create NAME --source DIR | delete NAME]")
    return 2
end

fn cmd_init(c: config::Config, o: Opts) -> int is
    let mut cc: config::Config = c
    if o.op_fs != "" is cc = config::set(cc, "fstype", o.op_fs) end
    let p: setup::Plan = setup::plan(cc)
    if o.op_plan is
        setup::print_plan(p, o.op_porcelain)
        if array_len(p.pl_errors) > 0 is return 1 end
        return 0
    end
    if !o.op_yes is
        setup::print_plan(p, false)
        if array_len(p.pl_errors) > 0 is return 1 end
        if !util::confirm("Apply these changes?") is
            ui::note("aborted")
            return 1
        end
    end
    return setup::init(cc)
end

fn cmd_offsite(c: config::Config, pos: [string]) -> int is
    let sub: string = if array_len(pos) > 0 then pos[0] else "status"
    if sub == "status" is
        offsite::status(c)
        return 0
    end
    if !need_root() is return 1 end
    if sub == "test" is
        if offsite::test(c) is
            ui::ok("target is reachable and writable")
            return 0
        end
        return 1
    end
    if sub == "run" || sub == "sync" is
        let n: int = offsite::sync(c)
        if n < 0 is return 1 end
        ui::ok(to_string(n) + " snapshot(s) copied")
        return 0
    end
    if sub == "prune" is
        ui::ok(to_string(offsite::prune(c)) + " old copy/copies removed from the target")
        return 0
    end
    ui::fail("usage: hackeros-snapshots offsite [status | run | test | prune]")
    return 2
end

fn cmd_roots(c: config::Config, pos: [string], o: Opts) -> int is
    if !need_root() is return 1 end
    if fsinfo::effective(c) != "btrfs" || !fsinfo::is_root_config(c) is
        ui::note("old roots only exist for the root config on btrfs")
        return 0
    end
    let sub: string = if array_len(pos) > 0 then pos[0] else "list"
    if sub == "list" is
        let list: [roots::Root] = roots::list()
        let mut i: int = 0
        while i < array_len(list) is
            if o.op_porcelain is
                write(list[i].rt_name + "\t" + to_string(list[i].rt_epoch) + "\t" + (if list[i].rt_running then "running" else "idle"))
            else is
                ui::line(util::pad_right(list[i].rt_name, 40) + util::fmt_epoch(list[i].rt_epoch) + (if list[i].rt_running then "   (still mounted — reboot first)" else ""))
            end
            i += 1
        end
        if array_len(list) == 0 && !o.op_porcelain is ui::note("no old roots") end
        fsinfo::umount_top()
        return 0
    end
    if sub == "prune" is
        let n: int = roots::prune(c, o.op_dry)
        ui::note(to_string(n) + " old root(s) " + (if o.op_dry then "would be deleted" else "deleted"))
        return 0
    end
    if sub == "delete" && array_len(pos) >= 2 is
        if roots::delete_named(pos[1]) is
            ui::ok("deleted " + pos[1])
            return 0
        end
        return 1
    end
    ui::fail("usage: hackeros-snapshots roots [list | prune | delete NAME]")
    return 2
end

;; ── apt hooks ────────────────────────────────────────────────────────────────
;; Must NEVER break apt: always return 0.

fn apt_state() -> string is return "/run/hackeros-snapshots.apt-pre" end

fn cmd_apt_pre() -> int is
    if !util::is_root() is return 0 end
    let names: [string] = config::names()
    let mut state: string = ""
    let mut i: int = 0
    while i < array_len(names) is
        let c: config::Config = config::load_named(names[i])
        i += 1
        if !config::b(c, "enabled") || !config::b(c, "apt_hooks") || !config::valid(c) || !dir_exists(config::s(c, "store")) is continue end
        let id: int = manager::take(c, "pre", "apt", 0, true)
        if id > 0 is state = state + c.cf_name + "=" + to_string(id) + "\n" end
    end
    if state != "" is util::write_file(apt_state(), state) end
    return 0
end

fn cmd_apt_post() -> int is
    if !util::is_root() || !file_exists(apt_state()) is return 0 end
    let lines: [string] = string_split(util::read_or(apt_state(), ""), "\n")
    util::run("rm -f " + util::sq(apt_state()))
    let mut i: int = 0
    while i < array_len(lines) is
        let eq: int = string_find(lines[i], "=")
        let ln: string = lines[i]
        i += 1
        if eq <= 0 is continue end
        let name: string = string_slice(ln, 0, eq)
        let pre: int = util::to_int_or(string_slice(ln, eq + 1, string_len(ln)), 0)
        if pre <= 0 || !config::exists(name) is continue end
        let c: config::Config = config::load_named(name)
        let id: int = manager::take(c, "post", "apt (after #" + to_string(pre) + ")", pre, true)
        if id > 0 is
            retention::cleanup(c, false, false)
            grub::update(c)
        end
    end
    return 0
end

;; ── dispatch ─────────────────────────────────────────────────────────────────

pub fn dispatch(cmd: string, pos: [string], o: Opts) -> int is
    let name: string = if o.op_config != "" then o.op_config else "root"
    if !config::exists(name) is
        ui::fail("no config '" + name + "'   (hackeros-snapshots config list)")
        return 1
    end
    let c: config::Config = config::load_named(name)
    match cmd is
        "create"        => is return cmd_create(c, o) end
        "list" | "ls"   => is return cmd_list(c, o) end
        "delete" | "rm" => is return cmd_delete(c, pos, o) end
        "rollback"      => is return cmd_rollback(c, pos, o) end
        "pin"           => is return cmd_pin(c, pos, true) end
        "unpin"         => is return cmd_pin(c, pos, false) end
        "cleanup"       => is return cmd_cleanup(c, o) end
        "usage"         => is return cmd_usage(c, o) end
        "diff"          => is return cmd_diff(c, pos, o) end
        "browse"        => is return cmd_browse(c, pos, o) end
        "restore"       => is return cmd_restore(c, pos, o) end
        "status"        => is return cmd_status() end
        "config"        => is return cmd_config(c, pos, o) end
        "init"          => is return cmd_init(c, o) end
        "offsite"       => is return cmd_offsite(c, pos) end
        "roots"         => is return cmd_roots(c, pos, o) end
        "daemon"        => is
            if !need_root() is return 1 end
            daemon::run()
            return 0
        end
        "boot"          => is
            if !need_root() is return 1 end
            daemon::boot_tasks()
            return 0
        end
        "tray"          => is return tray::run() end
        "grub-entries"  => is
            write(grub::entries(config::load()))
            return 0
        end
        "grub-update"   => is
            if !need_root() is return 1 end
            return grub::update(config::load())
        end
        "apt-pre"       => is return cmd_apt_pre() end
        "apt-post"      => is return cmd_apt_post() end
        "notify-test"   => is
            notify::event("error", "HackerOS Snapshots", "This is a test notification.")
            ui::ok("sent (check the log: journalctl -t hackeros-snapshots)")
            return 0
        end
        _ => is
            ui::fail("unknown command '" + cmd + "'   (hackeros-snapshots --help)")
            return 2
        end
    end
    return 0
end
