pub struct Opts is
    pub op_desc:      string
    pub op_type:      string
    pub op_config:    string
    pub op_source:    string
    pub op_to:        string
    pub op_fs:        string
    pub op_method:    string
    pub op_pre:       int
    pub op_porcelain: bool
    pub op_yes:       bool
    pub op_force:     bool
    pub op_dry:       bool
    pub op_offline:   bool
    pub op_all:       bool
    pub op_plan:      bool
    pub op_nobackup:  bool
    pub op_delete:    bool
    pub op_deep:      bool
    pub op_usage:     bool
end

