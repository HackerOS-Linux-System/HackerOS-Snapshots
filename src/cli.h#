fn need_root() -> bool is
    if util::is_root() is return true end
    ui::fail("this command needs root (try: sudo hackeros-snapshots …)")
    return false
end

fn arg_id(pos: [string], i: int) -> int is
    if i >= array_len(pos) is return -1 end
    return util::to_int_or(string_replace(pos[i], "#", ""), -1)
end

;; "current" / "live" / "now" / "0" → 0 (the live system)
fn arg_side(pos: [string], i: int) -> int is
    if i >= array_len(pos) is return 0 end
    let t: string = string_lower(pos[i])
    if t == "current" || t == "live" || t == "now" || t == "0" is return 0 end
    return arg_id(pos, i)
end

fn config_ready(c: config::Config) -> bool is
    if config::valid(c) is return true end
    ui::fail("config '" + c.cf_name + "' has no source — check " + config::path_of(c.cf_name))
    return false
end

;; ── snapshots ────────────────────────────────────────────────────────────────

fn cmd_create(c: config::Config, o: Opts) -> int is
    if !need_root() || !config_ready(c) is return 1 end
    let t: string = if o.op_type != "" then o.op_type else "manual"
    if t != "manual" && t != "boot" && t != "timeline" && t != "pre" && t != "post" is
        ui::fail("unknown type '" + t + "' (manual, boot, timeline, pre, post)")
        return 2
    end
    let d: string = if o.op_desc != "" then o.op_desc else "Manual snapshot"
    let id: int = manager::take(c, t, d, o.op_pre, false)
    if id < 0 is return 1 end
    ui::ok("snapshot #" + to_string(id) + " created  (" + c.cf_name + ")")
    if offsite::enabled(c) && config::b(c, "offsite_after_create") && util::has_str(util::csv(config::s(c, "offsite_types")), t) is
        offsite::sync(c)
    end
    grub::update(c)
    return 0
end

fn cmd_list(c: config::Config, o: Opts) -> int is
    let list: [store::Snap] = store::all(c)
    let mut usg: [usage::Use] = []
    if o.op_usage is usg = usage::per_snapshot(c, false) end
    if o.op_porcelain is
        ;; id type epoch date pinned desc kver pre   (tab separated)
        let mut i: int = 0
        while i < array_len(list) is
            let s: store::Snap = list[i]
            write(to_string(s.sn_id) + "\t" + s.sn_type + "\t" + to_string(s.sn_epoch) + "\t" + util::fmt_epoch(s.sn_epoch) + "\t" + (if s.sn_pinned then "*" else "-") + "\t" + s.sn_desc + "\t" + s.sn_kver + "\t" + to_string(s.sn_pre))
            i += 1
        end
        return 0
    end
    if array_len(list) == 0 is
        ui::note("no snapshots yet in config '" + c.cf_name + "' — take one with: sudo hackeros-snapshots create")
        return 0
    end
    ui::blank()
    write("  " + ui::bold(util::pad_right("ID", 6) + util::pad_right("TYPE", 10) + util::pad_right("DATE", 18) + util::pad_right("PIN", 5) + (if o.op_usage then util::pad_right("SIZE", 11) else "") + "DESCRIPTION"))
    let mut i: int = array_len(list) - 1
    while i >= 0 is
        let s: store::Snap = list[i]
        write("  " + util::pad_right("#" + to_string(s.sn_id), 6) + util::pad_right(s.sn_type, 10) + util::pad_right(util::fmt_epoch(s.sn_epoch), 18) + util::pad_right(if s.sn_pinned then "*" else "", 5) + (if o.op_usage then util::pad_right(if array_len(usg) > 0 then usage::fmt_mb(usage::mb_of(usg, s.sn_id)) else "?", 11) else "") + s.sn_desc)
        i -= 1
    end
    ui::blank()
    return 0
end

fn cmd_delete(c: config::Config, pos: [string], o: Opts) -> int is
    if !need_root() is return 1 end
    if array_len(pos) == 0 is
        ui::fail("usage: hackeros-snapshots delete <id...>")
        return 2
    end
    let mut rc: int = 0
    let mut i: int = 0
    while i < array_len(pos) is
        let id: int = arg_id(pos, i)
        i += 1
        if id < 0 is
            ui::fail("not a snapshot id")
            rc = 1
        else if snap::delete(c, id, o.op_force) is
            ui::ok("deleted #" + to_string(id))
        else is
            rc = 1
        end
    end
    grub::update(c)
    return rc
end

fn cmd_rollback(c: config::Config, pos: [string], o: Opts) -> int is
    let id: int = arg_id(pos, 0)
    if id < 0 is
        ui::fail("usage: hackeros-snapshots rollback <id>")
        return 2
    end
    if !o.op_offline && !o.op_yes is
        ui::warn("this replaces the current state of '" + c.cf_name + "' with snapshot #" + to_string(id) + " (a safety snapshot is taken first).")
        if !util::confirm("Continue?") is
            ui::note("aborted")
            return 1
        end
    end
    let rc: int = snap::rollback(c, id, o.op_offline)
    if rc == 0 && !o.op_offline && fsinfo::is_root_config(c) is
        ui::warn("reboot now to finish:  sudo systemctl reboot")
    end
    return rc
end

fn cmd_pin(c: config::Config, pos: [string], pinned: bool) -> int is
    if !need_root() is return 1 end
    let id: int = arg_id(pos, 0)
    if id < 0 is
        ui::fail("usage: hackeros-snapshots pin|unpin <id>")
        return 2
    end
    if snap::set_pinned(c, id, pinned) is
        ui::ok("snapshot #" + to_string(id) + (if pinned then " pinned" else " unpinned"))
        return 0
    end
    return 1
end

fn cleanup_one(c: config::Config, o: Opts) -> int is
    if !dir_exists(config::s(c, "store")) is return 0 end
    let n: int = retention::cleanup(c, o.op_dry, true)
    if !o.op_dry && n > 0 is grub::update(c) end
    return n
end

fn cmd_cleanup(c: config::Config, o: Opts) -> int is
    if !o.op_dry && !need_root() is return 1 end
    let mut total: int = 0
    if o.op_all is
        let names: [string] = config::names()
        let mut i: int = 0
        while i < array_len(names) is
            total += cleanup_one(config::load_named(names[i]), o)
            i += 1
        end
    else is
        total = cleanup_one(c, o)
    end
    if o.op_dry is
        ui::note(to_string(total) + " item(s) would be deleted")
    else is
        ui::ok(to_string(total) + " item(s) deleted")
    end
    return 0
end

fn cmd_usage(c: config::Config, o: Opts) -> int is
    let fs: string = fsinfo::effective(c)
    let usg: [usage::Use] = usage::per_snapshot(c, true)
    if o.op_porcelain is
        let mut k: int = 0
        while k < array_len(usg) is
            write(to_string(usg[k].us_id) + "\t" + to_string(usg[k].us_mb))
            k += 1
        end
        return 0
    end
    ui::heading("Disk usage — config " + c.cf_name)
    ui::line(util::pad_right("filesystem", 18) + fs + "   " + to_string(usage::free_percent(c)) + "% free  (" + usage::fmt_mb(usage::avail_mb(c)) + " of " + usage::fmt_mb(usage::total_mb(c)) + ")")
    let limit: int = usage::limit_mb(c)
    ui::line(util::pad_right("limit", 18) + (if limit > 0 then to_string(config::n(c, "max_usage_percent")) + "% of the disk = " + usage::fmt_mb(limit) else "none (max_usage_percent = 0)"))
    if array_len(usg) == 0 is
        if fs == "btrfs" is
            ui::warn("btrfs qgroups are off — run: hackeros-snapshots init   (or: btrfs quota enable /)")
        else is
            ui::note("no snapshots")
        end
        return 0
    end
    ui::line(util::pad_right("snapshots use", 18) + usage::fmt_mb(usage::sum(usg)))
    ui::blank()
    let list: [store::Snap] = store::all(c)
    let mut i: int = array_len(list) - 1
    while i >= 0 is
        ui::line(util::pad_right("#" + to_string(list[i].sn_id), 7) + util::pad_right(list[i].sn_type, 10) + util::pad_right(util::fmt_epoch(list[i].sn_epoch), 18) + usage::fmt_mb(usage::mb_of(usg, list[i].sn_id)))
        i -= 1
    end
    ui::note(if fs == "btrfs" then "sizes = data only this snapshot holds (btrfs qgroup exclusive)" else "sizes = what is new compared with all NEWER snapshots (hard links counted once)")
    ui::blank()
    return 0
end

;; ── look inside / get files back ─────────────────────────────────────────────

fn kind_label(k: string) -> string is
    if k == "+" is return ui::green("+ added   ") end
    if k == "-" is return ui::red("- deleted ") end
    if k == "c" is return ui::yellow("~ changed ") end
    if k == "r" is return ui::cyan("> renamed ") end
    return ui::dim("· metadata")
end

fn cmd_diff(c: config::Config, pos: [string], o: Opts) -> int is
    let a: int = arg_id(pos, 0)
    let b: int = arg_side(pos, 1)
    if a <= 0 || b < 0 is
        ui::fail("usage: hackeros-snapshots diff <id> [id | current]")
        return 2
    end
    if !store::exists(c, a) || (b > 0 && !store::exists(c, b)) is
        ui::fail("no such snapshot")
        return 1
    end
    let lines: [string] = diff::changes(c, a, b, o.op_method, o.op_deep)
    if o.op_porcelain is
        let mut p: int = 0
        while p < array_len(lines) is
            write(lines[p])
            p += 1
        end
        return 0
    end
    ui::heading("#" + to_string(a) + "  →  " + (if b == 0 then "current system" else "#" + to_string(b)) + "   (config " + c.cf_name + ")")
    if array_len(lines) == 0 is
        ui::note("no differences")
        ui::blank()
        return 0
    end
    let mut n_add: int = 0
    let mut n_del: int = 0
    let mut n_chg: int = 0
    let mut i: int = 0
    while i < array_len(lines) is
        let f: [string] = string_split(lines[i], "\t")
        i += 1
        if array_len(f) < 2 is continue end
        ui::line(kind_label(f[0]) + " " + f[1])
        if f[0] == "+" is n_add += 1 else if f[0] == "-" is n_del += 1 else is n_chg += 1 end
    end
    ui::blank()
    ui::note(to_string(n_add) + " added, " + to_string(n_del) + " deleted, " + to_string(n_chg) + " changed / renamed")
    ui::note("get a file back:  sudo hackeros-snapshots restore " + to_string(a) + " /path/to/file")
    ui::blank()
    return 0
end

fn cmd_browse(c: config::Config, pos: [string], o: Opts) -> int is
    let id: int = arg_id(pos, 0)
    if id <= 0 || !store::exists(c, id) is
        ui::fail("usage: hackeros-snapshots browse <id> [/path]")
        return 2
    end
    let rel: string = if array_len(pos) > 1 then pos[1] else "/"
    let lines: [string] = diff::browse(c, id, rel)
    if o.op_porcelain is
        let mut p: int = 0
        while p < array_len(lines) is
            write(lines[p])
            p += 1
        end
        return 0
    end
    ui::heading("snapshot #" + to_string(id) + ":" + rel)
    let mut i: int = 0
    while i < array_len(lines) is
        let f: [string] = string_split(lines[i], "\t")
        i += 1
        if array_len(f) < 3 is continue end
        if f[0] == "d" is ui::line(ui::cyan(f[2] + "/")) else is ui::line(f[2] + ui::dim("   " + f[1] + " B")) end
    end
    if array_len(lines) == 0 is ui::note("(empty or not found)") end
    ui::blank()
    return 0
end

fn cmd_restore(c: config::Config, pos: [string], o: Opts) -> int is
    let id: int = arg_id(pos, 0)
    if id <= 0 || array_len(pos) < 2 is
        ui::fail("usage: hackeros-snapshots restore <id> <path...> [--to DIR] [--delete] [--no-backup]")
        return 2
    end
    let mut items: [string] = []
    let mut i: int = 1
    while i < array_len(pos) is
        items = array_push(items, pos[i])
        i += 1
    end
    if o.op_to == "" && !o.op_yes is
        ui::warn("this overwrites " + to_string(array_len(items)) + " path(s) in place with the versions from snapshot #" + to_string(id) + (if o.op_nobackup then " (NO backup of the current files)." else " (current files are backed up first)."))
        if !util::confirm("Continue?") is
            ui::note("aborted")
            return 1
        end
    end
    return diff::restore(c, id, items, o.op_to, !o.op_nobackup, o.op_delete)
end

