mod util
mod ui
mod config
mod fsinfo
mod usage

pub struct Plan is
    pub pl_fs:     string
    pub pl_steps:  [string]
    pub pl_warns:  [string]
    pub pl_errors: [string]
end

fn store_subvol_name(c: config::Config) -> string is
    let cur: string = config::s(c, "store_subvol")
    if cur != "" is return cur end
    if fsinfo::root_subvol() == "@" is return "@snapshots" end
    return "hackeros-snapshots"
end

;; What init would do — nothing is changed.
pub fn plan(c: config::Config) -> Plan is
    let fs: string = fsinfo::effective(c)
    let mut steps: [string] = []
    let mut warns: [string] = []
    let mut errors: [string] = []
    let src: string = config::s(c, "source")
    let store_dir: string = config::s(c, "store")

    if src == "" is errors = array_push(errors, "config '" + c.cf_name + "' has no source directory") end
    if !dir_exists(src) && src != "" is errors = array_push(errors, "source " + src + " does not exist") end
    if !fsinfo::supported(fs) is
        errors = array_push(errors, "filesystem of " + src + " is '" + fs + "' — only btrfs and ext4 are supported")
    end
    if fs == "ext4" && !util::tool_exists("rsync") is errors = array_push(errors, "ext4 snapshots need rsync (apt install rsync)") end
    if fs == "btrfs" && !util::tool_exists("btrfs") is errors = array_push(errors, "btrfs snapshots need btrfs-progs (apt install btrfs-progs)") end

    if fs == "btrfs" && array_len(errors) == 0 is
        if fsinfo::is_root_config(c) is
            let root_sub: string = fsinfo::root_subvol()
            if root_sub == "" is
                errors = array_push(errors, "/ is the top-level btrfs volume (no root subvolume such as '@') — snapshots would work, rollback would not")
            else is
                let sub: string = store_subvol_name(c)
                steps = array_push(steps, "create the btrfs subvolume '" + sub + "' in the top level of " + fsinfo::root_device() + " (snapshots live outside the root subvolume '" + root_sub + "', so a rollback keeps them)")
                steps = array_push(steps, "mount it on " + store_dir + " (subvol=" + sub + ")")
                if util::run("grep -qs " + util::sq(" " + store_dir + " ") + " /etc/fstab") != 0 is
                    steps = array_push(steps, "add a line for " + store_dir + " to /etc/fstab")
                end
            end
        else is
            if !fsinfo::is_subvolume(src) is
                errors = array_push(errors, src + " is not a btrfs subvolume — make it one (or mount a subvolume there); snapshots need a subvolume root")
            else is
                steps = array_push(steps, "create the nested subvolume " + store_dir + " (not part of the snapshots of " + src + ")")
                warns = array_push(warns, "rollback of '" + c.cf_name + "' restores the files with rsync (a mounted subvolume cannot be swapped)")
            end
        end
        if config::b(c, "qgroups") && !usage::qgroups_enabled(c) is
            steps = array_push(steps, "enable btrfs quotas (qgroups) — needed for the disk usage limit; small performance cost")
        end
    end
    if fs == "ext4" && array_len(errors) == 0 is
        steps = array_push(steps, "create the directory " + store_dir + " (rsync snapshots, hard-linked to save space)")
        warns = array_push(warns, "snapshots share the partition with your data — they are not a backup (see the offsite option)")
    end
    if array_len(errors) == 0 is
        steps = array_push(steps, "write the configuration " + config::path_of(c.cf_name))
        steps = array_push(steps, "then:  systemctl enable --now hackeros-snapshots.service")
    end
    return Plan { pl_fs: fs, pl_steps: steps, pl_warns: warns, pl_errors: errors }
end

pub fn print_plan(p: Plan, porcelain: bool) is
    let mut i: int = 0
    if porcelain is
        write("fs\t" + p.pl_fs)
        while i < array_len(p.pl_steps) is
            write("step\t" + p.pl_steps[i])
            i += 1
        end
        i = 0
        while i < array_len(p.pl_warns) is
            write("warn\t" + p.pl_warns[i])
            i += 1
        end
        i = 0
        while i < array_len(p.pl_errors) is
            write("error\t" + p.pl_errors[i])
            i += 1
        end
        return
    end
    ui::heading("init plan  (filesystem: " + p.pl_fs + ")")
    while i < array_len(p.pl_steps) is
        ui::line("•  " + p.pl_steps[i])
        i += 1
    end
    i = 0
    while i < array_len(p.pl_warns) is
        ui::warn(p.pl_warns[i])
        i += 1
    end
    i = 0
    while i < array_len(p.pl_errors) is
        ui::fail(p.pl_errors[i])
        i += 1
    end
    ui::blank()
end

fn init_btrfs_root(c: config::Config) -> config::Config is
    let mut o: config::Config = c
    let sub: string = store_subvol_name(c)
    o = config::set(o, "store_subvol", sub)
    let store_dir: string = config::s(c, "store")
    let dev: string = fsinfo::root_device()
    let top: string = fsinfo::mount_top()
    if top == "" is
        ui::fail("cannot mount the btrfs top level of " + dev)
        return c
    end
    if !dir_exists(top + "/" + sub) is
        if util::run("btrfs subvolume create " + util::sq(top + "/" + sub) + " >/dev/null") != 0 is
            ui::fail("cannot create subvolume " + sub)
            fsinfo::umount_top()
            return c
        end
        ui::ok("created btrfs subvolume '" + sub + "'")
    end
    fsinfo::umount_top()

    util::mkdir_p(store_dir)
    if !util::is_mountpoint(store_dir) is
        if util::run("mount -o subvol=" + util::sq(sub) + " " + util::sq(dev) + " " + util::sq(store_dir)) != 0 is
            ui::fail("cannot mount " + sub + " on " + store_dir)
            return c
        end
    end
    ui::ok(store_dir + " mounted (subvol=" + sub + ")")

    if util::run("grep -qs " + util::sq(" " + store_dir + " ") + " /etc/fstab") != 0 is
        let line: string = "UUID=" + fsinfo::uuid_of("/") + " " + store_dir + " btrfs subvol=" + sub + ",noatime 0 0"
        util::run("printf '%s\\n' " + util::sq(line) + " >> /etc/fstab")
        ui::ok("added to /etc/fstab")
    end
    return o
end

fn init_btrfs_nested(c: config::Config) -> bool is
    let store_dir: string = config::s(c, "store")
    if dir_exists(store_dir) is
        ui::ok(store_dir + " already exists")
        return true
    end
    if util::run("btrfs subvolume create " + util::sq(store_dir) + " >/dev/null") != 0 is
        ui::fail("cannot create the subvolume " + store_dir)
        return false
    end
    ui::ok("created nested subvolume " + store_dir)
    return true
end

;; Returns 0 on success.
pub fn init(c: config::Config) -> int is
    if !util::is_root() is
        ui::fail("init needs root")
        return 1
    end
    let p: Plan = plan(c)
    if array_len(p.pl_errors) > 0 is
        print_plan(p, false)
        return 1
    end
    let fs: string = p.pl_fs
    let mut o: config::Config = c
    if fs == "btrfs" is
        if fsinfo::is_root_config(c) is
            o = init_btrfs_root(c)
            if config::s(o, "store_subvol") == "" is return 1 end
        else is
            if !init_btrfs_nested(c) is return 1 end
        end
        if config::b(c, "qgroups") is
            if usage::enable_qgroups(c) is ui::ok("btrfs qgroups enabled") else is ui::warn("could not enable qgroups — the disk usage limit will not work") end
        end
    else is
        util::mkdir_p(config::s(c, "store"))
        ui::ok("created " + config::s(c, "store"))
    end
    util::run("chmod 755 " + util::sq(config::s(c, "store")))
    config::save(o)
    ui::ok("config written to " + config::path_of(c.cf_name))
    ui::blank()
    ui::note("next: systemctl enable --now hackeros-snapshots.service")
    return 0
end
