[package]
-> name        => hackeros-snapshots-gui
-> version     => 0.3.0
-> description => Silver GUI (TypeScript + Solid.js) for HackerOS Snapshots: dashboard, snapshots, diff, browse, settings, offsite, activity, setup wizard
-> authors     => ["HackerOS Team <hackeros068@gmail.com>"]
-> license     => GPL-3.0
-> lang        => h#

[layout]
-> src => src

[build]
-> link => static

[default-build]
-> profile => release

[dependencies]
-> silver => newest

[hooks]
-> pre-build => cd frontend && npm install --no-audit --no-fund && npm run build

[commands]
-> frontend
--> run => cd frontend && npm install --no-audit --no-fund && npm run build
--> description => Build the front-end (TypeScript + Solid -> frontend/dist/app.js)
-> watch
--> run => cd frontend && npm run watch
--> description => Rebuild the front-end on every change (run next to `bit run`; hot reload picks up dist/app.js)
-> test
--> run => cd frontend && npm run typecheck && npm test
--> description => Type-check the front-end and run the parser unit tests
