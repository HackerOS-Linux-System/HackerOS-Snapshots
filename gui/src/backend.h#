pub fn sq(s: string) -> string is
    return "'" + string_replace(s, "'", "'\\''") + "'"
end

pub fn is_root() -> bool is
    return string_trim(shell("id -u")) == "0"
end

;; read-only call, trimmed stdout
pub fn cli(args: string) -> string is
    return string_trim(shell("hackeros-snapshots " + args + " 2>/dev/null"))
end

pub fn cli_lines(args: string) -> [string] is
    let out: string = cli(args)
    if out == "" is
        let none: [string] = []
        return none
    end
    return string_split(out, "\n")
end

;; command line of a privileged call (as root: direct; else through pkexec)
pub fn priv_cmd(args: string) -> string is
    return (if is_root() then "" else "pkexec ") + "hackeros-snapshots " + args
end

pub fn to_int_or(s: string, fallback: int) -> int is
    let t: string = string_trim(s)
    let n: int = string_len(t)
    if n == 0 || n > 9 is return fallback end
    let mut i: int = 0
    while i < n is
        if !string_contains("0123456789", string_at(t, i)) is return fallback end
        i += 1
    end
    return to_int(t)
end

;; Silver has no HTML entities: make text safe for the parser and the {{template}} pass.
pub fn esc(s: string) -> string is
    let a: string = string_replace(s, "<", "‹")
    let b: string = string_replace(a, ">", "›")
    let c: string = string_replace(b, "\"", "'")
    let d: string = string_replace(c, "{{", "{ {")
    return string_replace(d, "\n", " ")
end

;; ── config of one entry, from `config show` ──────────────────────────────────

pub fn cfg_lines(cfg: string) -> [string] is
    return cli_lines("-c " + sq(cfg) + " config show")
end

pub fn cfg_get(lines: [string], key: string) -> string is
    let mut i: int = 0
    while i < array_len(lines) is
        let ln: string = string_trim(lines[i])
        i += 1
        if string_starts_with(ln, "-> " + key + " ") || string_starts_with(ln, "-> " + key + "=") is
            let at: int = string_find(ln, "=>")
            if at >= 0 is return string_trim(string_slice(ln, at + 2, string_len(ln))) end
        end
    end
    return ""
end

pub fn config_names() -> [string] is
    let names: [string] = cli_lines("config list")
    if array_len(names) == 0 is return ["root"] end
    return names
end

;; ── snapshots, from `list --porcelain` ───────────────────────────────────────
;; fields: 0 id  1 type  2 epoch  3 date  4 pin(*/-)  5 desc  6 kernel  7 pre

pub fn snap_rows(cfg: string) -> [string] is
    return cli_lines("-c " + sq(cfg) + " list --porcelain")
end

pub fn field(row: string, i: int) -> string is
    let f: [string] = string_split(row, "\t")
    if i < array_len(f) is return f[i] end
    return ""
end

pub fn row_of(rows: [string], id: string) -> string is
    let mut i: int = 0
    while i < array_len(rows) is
        if field(rows[i], 0) == id is return rows[i] end
        i += 1
    end
    return ""
end

pub fn on_off(v: string) -> string is
    if v == "true" is return "ON" end
    return "OFF"
end
