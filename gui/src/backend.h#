use "bit -> silver" from "silver"

;; Helpers for the command layer. The window logic lives in the TypeScript
;; front-end (gui/frontend/src); this module only shells out to the CLI.

pub fn sq(s: string) -> string is
    return "'" + string_replace(s, "'", "'\\''") + "'"
end

pub fn is_root() -> bool is
    return string_trim(shell("id -u")) == "0"
end

pub fn home() -> string is
    return string_trim(shell("echo $HOME"))
end

;; "pkexec " unless we already are root
pub fn priv_prefix() -> string is
    if is_root() is return "" end
    return "pkexec "
end

pub fn to_int_or(s: string, fallback: int) -> int is
    let t: string = string_trim(s)
    let n: int = string_len(t)
    if n == 0 || n > 9 is return fallback end
    let mut i: int = 0
    while i < n is
        if !string_contains("0123456789", string_at(t, i)) is return fallback end
        i += 1
    end
    return to_int(t)
end

;; JSON array of strings (raw) -> plain strings
pub fn words_of(raw_array: string) -> [string] is
    let items: [string] = data::items(raw_array)
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(items) is
        out = array_push(out, data::text(items[i]))
        i += 1
    end
    return out
end

pub fn quote_words(words: [string]) -> string is
    let mut out: string = ""
    let mut i: int = 0
    while i < array_len(words) is
        out = out + " " + sq(words[i])
        i += 1
    end
    return out
end

;; drops a leading  -c NAME  pair
pub fn without_config(words: [string]) -> [string] is
    let mut out: [string] = []
    let mut start: int = 0
    if array_len(words) >= 2 && words[0] == "-c" is start = 2 end
    let mut i: int = start
    while i < array_len(words) is
        out = array_push(out, words[i])
        i += 1
    end
    return out
end

fn has_word(words: [string], w: string) -> bool is
    let mut i: int = 0
    while i < array_len(words) is
        if words[i] == w is return true end
        i += 1
    end
    return false
end

fn one_of(w: string, options: [string]) -> bool is
    return has_word(options, w)
end

;; read-only calls the UI may make without privileges
pub fn read_allowed(words: [string]) -> bool is
    let w: [string] = without_config(words)
    if array_len(w) == 0 is return false end
    let c: string = w[0]
    if one_of(c, ["list", "usage", "browse", "status"]) is return true end
    if c == "config" is
        return array_len(w) >= 2 && one_of(w[1], ["show", "list", "keys", "get"])
    end
    if c == "offsite" is
        return array_len(w) >= 2 && w[1] == "status"
    end
    if c == "init" is return has_word(w, "--plan") end
    return false
end

;; privileged calls (run through pkexec) the UI may start
pub fn job_allowed(words: [string]) -> bool is
    let w: [string] = without_config(words)
    if array_len(w) == 0 is return false end
    let c: string = w[0]
    if one_of(c, ["create", "delete", "pin", "unpin", "cleanup", "diff", "restore", "rollback", "init"]) is return true end
    if c == "config" is
        return array_len(w) >= 2 && one_of(w[1], ["apply", "create", "delete"])
    end
    if c == "offsite" is
        return array_len(w) >= 2 && one_of(w[1], ["test", "run", "prune"])
    end
    if c == "roots" is
        return array_len(w) >= 2 && w[1] == "prune"
    end
    return false
end

;; "<output>@@rc=N"  ->  {"rc": N, "out": "<output>"}
pub fn wrap_rc(raw: string) -> string is
    let n: int = string_len(raw)
    let mut at: int = -1
    let mut i: int = n - 40
    if i < 0 is i = 0 end
    while i + 5 <= n is
        if string_slice(raw, i, i + 5) == "@@rc=" is at = i end
        i += 1
    end
    let mut out: string = raw
    let mut rc: int = 1
    if at >= 0 is
        out = string_slice(raw, 0, at)
        rc = to_int_or(string_slice(raw, at + 5, n), 1)
    end
    let mut r: string = data::object()
    r = data::set_int(r, "rc", rc)
    r = data::set_str(r, "out", out)
    return r
end

pub fn forbidden(what: string) -> string is
    return ipc::error_json("forbidden", what + " is not allowed from the GUI")
end

pub fn prefs_dir() -> string is
    return home() + "/.config/hackeros-snapshots"
end

pub fn prefs_path() -> string is
    return prefs_dir() + "/gui.json"
end
