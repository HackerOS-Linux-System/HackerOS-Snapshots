use "bit -> silver" from "silver"
mod backend

;; HackerOS Snapshots GUI — Silver 0.2 back-end.
;;
;; The front-end (TypeScript + Solid.js, gui/frontend/src) talks to this file only
;; through silver.invoke():
;;
;;   sys_info    {}                        -> {root, service, store, store_exists, home, silver}
;;   cli_read    {args:[...]}              -> {rc, out}     read-only CLI calls (whitelisted)
;;   job_start   {id, args:[...], tool}    -> {queued}      privileged CLI call in the background
;;   file_write  {path, text}              -> {ok}          (capability "fs") export of a report
;;   prefs_load  {} / prefs_save {prefs}   -> JSON          ~/.config/hackeros-snapshots/gui.json
;;
;; A command handler has no access to App, so job_start returns a UI directive that
;; stores the request in the template state; on_tick (which has App) picks it up and
;; calls app::spawn_task. When the task ends Silver emits "silver://task" to JS.

fn h_sys_info(args: string) -> string is
    let store: string = string_trim(shell("hackeros-snapshots config get store 2>/dev/null"))
    let mut r: string = data::object()
    r = data::set_bool(r, "root", backend::is_root())
    r = data::set_str(r, "service", string_trim(shell("systemctl is-active hackeros-snapshots.service 2>/dev/null")))
    r = data::set_str(r, "store", store)
    r = data::set_bool(r, "store_exists", store != "" && dir_exists(store))
    r = data::set_str(r, "home", backend::home())
    r = data::set_str(r, "silver", app::version())
    return r
end

fn h_cli_read(args: string) -> string is
    let words: [string] = backend::words_of(data::get_raw(args, "args"))
    if !backend::read_allowed(words) is
        return backend::forbidden("this command")
    end
    let raw: string = shell("hackeros-snapshots" + backend::quote_words(words) + " 2>/dev/null; echo \"@@rc=$?\"")
    return backend::wrap_rc(raw)
end

fn h_job_start(args: string) -> string is
    let id: string = data::get_str(args, "id")
    let tool: string = data::get_str(args, "tool")
    let words: [string] = backend::words_of(data::get_raw(args, "args"))
    let mut cmd: string = ""
    if tool == "service" is
        cmd = backend::priv_prefix() + "systemctl enable --now hackeros-snapshots.service"
    else is
        if !backend::job_allowed(words) is
            return backend::forbidden("this operation")
        end
        cmd = backend::priv_prefix() + "hackeros-snapshots" + backend::quote_words(words)
    end
    let full: string = "( " + cmd + " ) 2>&1; echo \"@@rc=$?\""
    let mut req: string = data::object()
    req = data::set_str(req, "id", id)
    req = data::set_str(req, "cmd", full)
    let res: string = data::set_bool(data::object(), "queued", true)
    return ui::with(res, ui::set_state("job_req", req))
end

fn h_file_write(args: string) -> string is
    let path: string = data::get_str(args, "path")
    if path == "" || !string_starts_with(path, "/") is
        return ipc::error_json("invalid_args", "an absolute path is required")
    end
    file_write(path, data::get_str(args, "text"))
    return data::set_bool(data::object(), "ok", true)
end

fn h_prefs_load(args: string) -> string is
    let t: string = string_trim(shell("cat " + backend::sq(backend::prefs_path()) + " 2>/dev/null"))
    if t == "" is return data::object() end
    return t
end

fn h_prefs_save(args: string) -> string is
    shell("mkdir -p " + backend::sq(backend::prefs_dir()))
    file_write(backend::prefs_path(), data::get_raw(args, "prefs"))
    return data::set_bool(data::object(), "ok", true)
end

;; ── tick: start the job requested by the front-end ───────────────────────────

fn tick(a: app::App) -> app::App is
    let req: string = app::state(a, "job_req")
    if req == "" is return a end
    let cleared: app::App = app::set_state(a, "job_req", "")
    return app::spawn_task(cleared, data::get_str(req, "id"), data::get_str(req, "cmd"), "")
end

;; ── startup ──────────────────────────────────────────────────────────────────

fn gui_dir() -> string is
    if dir_exists("frontend") is return "frontend" end
    return "/usr/share/hackeros-snapshots/gui/frontend"
end

fn font_path() -> string is
    let cands: [string] = ["/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
                           "/usr/share/fonts/dejavu/DejaVuSans.ttf",
                           "/usr/share/fonts/TTF/DejaVuSans.ttf",
                           gui_dir() + "/fonts/DejaVuSans.ttf"]
    let mut i: int = 0
    while i < array_len(cands) is
        if file_exists(cands[i]) is return cands[i] end
        i += 1
    end
    return cands[3]
end

fn main() is
    let mut a: app::App = app::new("HackerOS Snapshots", 1100, 800)
    a = app::with_font(a, font_path(), 15)
    a = app::load_html(a, gui_dir() + "/index.html")
    a = app::load_css(a, gui_dir() + "/style.css")

    a = app::command(a, "sys_info", h_sys_info)
    a = app::command(a, "cli_read", h_cli_read)
    a = app::command(a, "job_start", h_job_start)
    a = app::command_cap(a, "file_write", "fs", h_file_write)
    a = app::command(a, "prefs_load", h_prefs_load)
    a = app::command(a, "prefs_save", h_prefs_save)
    a = app::allow_js(a, "fs")

    a = app::on_tick(a, tick)
    a = app::set_tick_interval(a, 50)
    a = app::load_js(a, [gui_dir() + "/dist/app.js"])
    if dir_exists("frontend") is a = app::enable_hot_reload(a) end
    app::run(a)
end
