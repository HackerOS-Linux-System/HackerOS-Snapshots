use "bit -> silver" from "app"
mod backend
mod jobs

fn st(a: app::App, k: string) -> string is
    return app::state(a, k)
end

fn btn(id: string, label: string, cls: string) -> string is
    return "<div class=\"btn " + cls + "\" id=\"" + id + "\" on-click=\"act\"><span>" + backend::esc(label) + "</span></div>"
end

fn txt(s: string, cls: string) -> string is
    return "<p class=\"" + cls + "\">" + backend::esc(s) + "</p>"
end

fn input(id: string, value: string, cls: string) -> string is
    return "<input class=\"" + cls + "\" id=\"" + id + "\" value=\"" + backend::esc(value) + "\" />"
end

fn tab(a: app::App, id: string, label: string) -> string is
    return btn("nav_" + id, label, if st(a, "view") == id then "tab on" else "tab")
end

;; ── frame: title, tabs, config bar, status line ──────────────────────────────

pub fn page(a: app::App, body: string) -> string is
    let cfg: string = st(a, "cfg")
    let mut h: string = "<div class=\"page\">"
    h = h + "<div class=\"top\"><h1>HackerOS Snapshots</h1>" + txt("btrfs / ext4 snapshots — config: " + cfg, "sub") + "</div>"
    h = h + "<div class=\"row\">" + tab(a, "snaps", "Snapshots") + tab(a, "diff", "Diff") + tab(a, "browse", "Browse") + tab(a, "settings", "Settings") + tab(a, "offsite", "Offsite") + tab(a, "wizard", "Setup") + "</div>"
    let names: [string] = backend::config_names()
    if array_len(names) > 1 is
        h = h + "<div class=\"row\">" + txt("Config:", "lbl")
        let mut i: int = 0
        while i < array_len(names) is
            h = h + btn("cfg_" + names[i], names[i], if names[i] == cfg then "chip on" else "chip")
            i += 1
        end
        h = h + "</div>"
    end
    h = h + "<div class=\"status\"><p>{{status}}</p></div>"
    h = h + body + "</div>"
    return h
end

;; ── Snapshots ────────────────────────────────────────────────────────────────

fn snap_row(row: string, selected: bool) -> string is
    let id: string = backend::field(row, 0)
    let pin: string = if backend::field(row, 4) == "*" then "*" else ""
    let mut h: string = "<div class=\"srow" + (if selected then " picked" else "") + "\" id=\"sel_" + id + "\" on-click=\"act\">"
    h = h + "<span class=\"c-mark\">" + (if selected then ">" else " ") + "</span>"
    h = h + "<span class=\"c-id\">#" + id + "</span>"
    h = h + "<span class=\"c-type\">" + backend::esc(backend::field(row, 1)) + "</span>"
    h = h + "<span class=\"c-date\">" + backend::esc(backend::field(row, 3)) + "</span>"
    h = h + "<span class=\"c-pin\">" + pin + "</span>"
    h = h + "<span class=\"c-desc\">" + backend::esc(backend::field(row, 5)) + "</span>"
    return h + "</div>"
end

pub fn snapshots(a: app::App) -> string is
    let cfg: string = st(a, "cfg")
    let rows: [string] = backend::snap_rows(cfg)
    let total: int = array_len(rows)
    let limit: int = backend::to_int_or(st(a, "limit"), 100)
    let sel: string = st(a, "sel")
    let cur: string = backend::row_of(rows, sel)

    let mut h: string = "<div class=\"card\"><h2>Take a snapshot</h2><div class=\"row\">"
    h = h + input("in_desc", "", "wide") + btn("act_create", "+ Create snapshot", "primary") + btn("act_refresh", "Refresh", "") + btn("act_cleanup", "Clean up old snapshots now", "")
    h = h + "</div></div>"

    h = h + "<div class=\"card\"><h2>Selected snapshot</h2>"
    if cur == "" is
        h = h + txt("Click a snapshot in the list below.", "sub")
    else is
        h = h + txt("#" + sel + "   " + backend::field(cur, 1) + "   " + backend::field(cur, 3) + (if backend::field(cur, 6) != "" then "   kernel " + backend::field(cur, 6) else "") + (if backend::field(cur, 4) == "*" then "   [pinned]" else ""), "sel")
        h = h + "<div class=\"row\">"
        h = h + btn("act_cmp_live", "Compare with now", "") + btn("act_cmp_prev", "Compare with previous", "") + btn("act_browse", "Browse files", "")
        h = h + btn("act_pin", if backend::field(cur, 4) == "*" then "Unpin" else "Pin", "")
        h = h + "</div><div class=\"row\">"
        h = h + btn("act_rollback", "Restore whole system to this", "danger") + btn("act_delete", "Delete", "danger")
        h = h + "</div>"
    end
    h = h + "</div>"

    h = h + "<div class=\"card\"><h2>Snapshots (" + to_string(total) + ")</h2>"
    h = h + "<div class=\"thead\"><span class=\"c-mark\"> </span><span class=\"c-id\">ID</span><span class=\"c-type\">TYPE</span><span class=\"c-date\">DATE</span><span class=\"c-pin\">PIN</span><span class=\"c-desc\">DESCRIPTION</span></div>"
    if total == 0 is
        h = h + txt("No snapshots yet — create one above, or run the Setup wizard first.", "sub")
    end
    let mut shown: int = 0
    let mut i: int = total - 1
    while i >= 0 && shown < limit is
        h = h + snap_row(rows[i], backend::field(rows[i], 0) == sel)
        shown += 1
        i -= 1
    end
    if total > shown is
        h = h + "<div class=\"row\">" + btn("act_more", "Show 100 more (" + to_string(total - shown) + " older)", "") + "</div>"
    end
    return h + "</div>"
end

;; ── Diff ─────────────────────────────────────────────────────────────────────

pub fn diff_lines() -> [string] is
    let raw: [string] = string_split(shell("cat " + backend::sq(jobs::path("diff.out")) + " 2>/dev/null"), "\n")
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(raw) is
        let ln: string = raw[i]
        i += 1
        if string_len(ln) > 2 && string_at(ln, 1) == "\t" && string_contains("+-cmr", string_at(ln, 0)) is
            out = array_push(out, ln)
        end
    end
    return out
end

fn kind_span(k: string) -> string is
    if k == "+" is return "<span class=\"c-kind k-add\">+ added</span>" end
    if k == "-" is return "<span class=\"c-kind k-del\">- deleted</span>" end
    if k == "c" is return "<span class=\"c-kind k-chg\">~ changed</span>" end
    if k == "r" is return "<span class=\"c-kind k-ren\">→ renamed</span>" end
    return "<span class=\"c-kind k-meta\">. metadata</span>"
end

pub fn diff(a: app::App) -> string is
    let da: string = st(a, "da")
    let db: string = st(a, "db")
    let mut h: string = "<div class=\"card\"><h2>Compare</h2><div class=\"row\">"
    h = h + txt("From snapshot #", "lbl") + input("in_da", da, "num") + txt("to #", "lbl") + input("in_db", db, "num") + txt("(0 or empty = the system as it is now)", "sub")
    h = h + "</div><div class=\"row\">" + btn("act_diff_run", "Compare", "primary") + "</div></div>"

    let lines: [string] = diff_lines()
    let dsel: string = st(a, "dpath")
    h = h + "<div class=\"card\"><h2>Changes (" + to_string(array_len(lines)) + ")</h2>"
    if st(a, "diff_done") != "1" is
        h = h + txt("Pick two snapshots (or use \"Compare with now\" on the Snapshots tab), then press Compare.", "sub")
    else if array_len(lines) == 0 is
        h = h + txt("No differences.", "sub")
    end
    let cap: int = 300
    let mut i: int = 0
    while i < array_len(lines) && i < cap is
        let k: string = string_slice(lines[i], 0, 1)
        let p: string = string_slice(lines[i], 2, string_len(lines[i]))
        h = h + "<div class=\"drow" + (if p == dsel then " picked" else "") + "\" id=\"df_" + to_string(i) + "\" on-click=\"act\">" + kind_span(k) + "<span class=\"c-path\">" + backend::esc(p) + "</span></div>"
        i += 1
    end
    if array_len(lines) > cap is
        h = h + txt("… " + to_string(array_len(lines) - cap) + " more not shown — narrow it down with `hackeros-snapshots diff` in a terminal.", "sub")
    end
    if dsel != "" is
        h = h + "<div class=\"row\">" + txt("Selected: " + dsel, "sel") + "</div><div class=\"row\">"
        h = h + btn("act_dres_a", "Restore it from #" + da, "danger")
        if backend::to_int_or(db, 0) > 0 is h = h + btn("act_dres_b", "Restore it from #" + db, "danger") end
        h = h + "</div>" + txt("The current file is kept in /var/lib/hackeros-snapshots/restore-backups/.", "sub")
    end
    return h + "</div>"
end

;; ── Browse ───────────────────────────────────────────────────────────────────

pub fn browse(a: app::App) -> string is
    let cfg: string = st(a, "cfg")
    let bid: string = st(a, "bid")
    let bpath: string = st(a, "bpath")
    let mut h: string = "<div class=\"card\"><h2>Browse a snapshot</h2><div class=\"row\">"
    h = h + txt("Snapshot #", "lbl") + input("in_bid", bid, "num") + btn("act_bgo", "Open", "primary") + btn("act_bup", "Up", "") + "</div>"
    if bid == "" is
        return h + txt("Enter a snapshot id, or press \"Browse files\" on the Snapshots tab.", "sub") + "</div>"
    end
    h = h + txt("#" + bid + ":" + bpath, "sel")
    let lines: [string] = backend::cli_lines("-c " + backend::sq(cfg) + " browse " + backend::sq(bid) + " " + backend::sq(bpath) + " --porcelain")
    let bsel: string = st(a, "bsel")
    let mut i: int = 0
    while i < array_len(lines) && i < 400 is
        let f: [string] = string_split(lines[i], "\t")
        if array_len(f) >= 3 is
            let isdir: bool = f[0] == "d"
            h = h + "<div class=\"drow" + (if f[2] == bsel then " picked" else "") + "\" id=\"bd_" + to_string(i) + "\" on-click=\"act\"><span class=\"c-kind " + (if isdir then "k-dir" else "k-file") + "\">" + (if isdir then "folder" else "file") + "</span><span class=\"c-path\">" + backend::esc(f[2]) + (if isdir then "/" else "") + "</span></div>"
        end
        i += 1
    end
    if array_len(lines) == 0 is h = h + txt("(empty, or the path does not exist)", "sub") end
    h = h + "<div class=\"row\">"
    if bsel != "" is
        h = h + btn("act_bres", "Restore \"" + bsel + "\" to the live system", "danger")
    else if bpath != "/" is
        h = h + btn("act_bres", "Restore this folder to the live system", "danger")
    end
    return h + "</div></div>"
end

;; ── Settings ─────────────────────────────────────────────────────────────────

fn toggle_row(cfgl: [string], key: string, label: string) -> string is
    return "<div class=\"row\">" + btn("tg_" + key, label + ":  " + backend::on_off(backend::cfg_get(cfgl, key)), "toggle") + "</div>"
end

fn field_row(cfgl: [string], key: string, label: string, cls: string) -> string is
    return "<div class=\"row\">" + txt(label, "lbl") + input("in_" + key, backend::cfg_get(cfgl, key), cls) + "</div>"
end

pub fn settings(a: app::App) -> string is
    let cfg: string = st(a, "cfg")
    let c: [string] = backend::cfg_lines(cfg)
    let is_root: bool = cfg == "root"
    let mut h: string = "<div class=\"card\"><h2>When snapshots are taken</h2>"
    h = h + toggle_row(c, "enabled", "Automatic snapshots") + toggle_row(c, "snapshot_on_boot", "Snapshot at every boot") + toggle_row(c, "timeline", "Timeline snapshots")
    h = h + field_row(c, "timeline_minutes", "Timeline every (minutes)", "num")
    h = h + toggle_row(c, "apt_hooks", "Snapshot before/after apt") + "</div>"

    h = h + "<div class=\"card\"><h2>Cleanup of old snapshots  (0 = unlimited)</h2>"
    h = h + toggle_row(c, "cleanup_on_boot", "Clean up at every boot")
    h = h + field_row(c, "keep_boot", "Keep boot snapshots", "num") + field_row(c, "keep_timeline", "Keep timeline snapshots", "num")
    h = h + field_row(c, "keep_prepost", "Keep apt pairs", "num") + field_row(c, "keep_manual", "Keep manual snapshots", "num")
    h = h + field_row(c, "max_age_days", "Delete older than (days)", "num") + field_row(c, "keep_min", "Always keep the newest", "num")
    h = h + field_row(c, "max_usage_percent", "Snapshots may use (% of disk)", "num") + field_row(c, "min_free_percent", "Keep at least (% free)", "num")
    h = h + toggle_row(c, "emergency_cleanup", "Delete oldest when the disk is full")
    if is_root is
        h = h + field_row(c, "keep_rollback_roots", "Keep old roots after rollback", "num") + field_row(c, "rollback_root_days", "Delete old roots after (days)", "num")
        h = h + "<div class=\"row\">" + btn("act_roots_prune", "Delete old rollback roots now", "") + "</div>"
    end
    h = h + "</div>"

    h = h + "<div class=\"card\"><h2>Files</h2>"
    h = h + field_row(c, "excludes", "Exclude paths (comma separated; - clears)", "wide")
    h = h + txt("btrfs: cut out of every snapshot. Tip: a nested subvolume is excluded for free.", "sub")
    if is_root is
        h = h + toggle_row(c, "grub", "GRUB restore entries") + field_row(c, "grub_max", "Entries in the GRUB menu", "num")
        h = h + "<div class=\"row\">" + txt("Notifications:", "lbl") + btn("nl_off", "off", if backend::cfg_get(c, "notify_level") == "off" then "chip on" else "chip") + btn("nl_errors", "errors", if backend::cfg_get(c, "notify_level") == "errors" then "chip on" else "chip") + btn("nl_all", "everything", if backend::cfg_get(c, "notify_level") == "all" then "chip on" else "chip") + "</div>"
    end
    h = h + "<div class=\"row\">" + btn("act_save", "Save settings", "primary") + "</div></div>"

    h = h + "<div class=\"card\"><h2>Configs</h2>" + txt("Each config snapshots one directory (e.g. /home) with its own rules.", "sub")
    h = h + "<div class=\"row\">" + txt("New config name", "lbl") + input("in_newname", "", "num") + txt("source", "lbl") + input("in_newsrc", "/home", "wide") + "</div>"
    h = h + "<div class=\"row\">" + btn("act_cfg_create", "Create config", "") + (if is_root then "" else btn("act_cfg_delete", "Delete config '" + cfg + "'", "danger")) + "</div></div>"
    return h
end

;; ── Offsite ──────────────────────────────────────────────────────────────────

pub fn offsite(a: app::App) -> string is
    let cfg: string = st(a, "cfg")
    let c: [string] = backend::cfg_lines(cfg)
    let mut h: string = "<div class=\"card\"><h2>Offsite backup — another disk or another machine</h2>"
    h = h + txt("btrfs: incremental btrfs send/receive.  ext4: rsync with hard links.  The target of a btrfs copy must be btrfs.", "sub")
    h = h + toggle_row(c, "offsite", "Copy snapshots offsite") + toggle_row(c, "offsite_after_create", "Copy right after they are taken")
    h = h + field_row(c, "offsite_target", "Target (/mnt/disk/dir or root@host:/dir)", "wide")
    h = h + field_row(c, "offsite_ssh_opts", "SSH options (e.g. -i /root/.ssh/key)", "wide")
    h = h + field_row(c, "offsite_types", "Snapshot types to copy", "wide") + field_row(c, "offsite_keep", "Keep on target (0 = all)", "num")
    h = h + "<div class=\"row\">" + btn("act_off_save", "Save", "primary") + btn("act_off_test", "Test connection", "") + btn("act_off_run", "Copy now", "") + btn("act_off_prune", "Prune target", "") + "</div></div>"
    let status: [string] = backend::cli_lines("-c " + backend::sq(cfg) + " offsite status")
    h = h + "<div class=\"card\"><h2>Status</h2>"
    let mut i: int = 0
    while i < array_len(status) is
        let t: string = string_replace(string_replace(status[i], "\x1b[0m", ""), "\x1b[1m", "")
        if string_trim(t) != "" && !string_contains(t, "────") is h = h + txt(string_trim(t), "sub") end
        i += 1
    end
    return h + "</div>"
end

;; ── Setup wizard ─────────────────────────────────────────────────────────────

fn fs_chip(a: app::App, id: string, label: string) -> string is
    let cur: string = if st(a, "wfs") == "" then "auto" else st(a, "wfs")
    return btn("wf_" + id, label, if cur == id then "chip on" else "chip")
end

pub fn wizard(a: app::App) -> string is
    let cfg: string = st(a, "cfg")
    let step: int = backend::to_int_or(st(a, "wstep"), 1)
    let fs: string = if st(a, "wfs") == "" then "auto" else st(a, "wfs")
    let fsflag: string = if fs == "auto" then "" else " --fs " + fs
    let mut h: string = "<div class=\"card\"><h2>Setup wizard — step " + to_string(step) + " of 3   (config '" + cfg + "')</h2>"

    if step == 1 is
        h = h + txt("This prepares the place where snapshots are stored and turns on the background service.", "sub")
        h = h + txt("Which filesystem should be used?  Auto detects it from the directory being snapshotted.", "sub")
        h = h + "<div class=\"row\">" + fs_chip(a, "auto", "Auto-detect") + fs_chip(a, "btrfs", "btrfs") + fs_chip(a, "ext4", "ext4") + "</div>"
        h = h + "<div class=\"row\">" + btn("wz_next", "Next: preview changes", "primary") + "</div>"
    else if step == 2 is
        let plan: [string] = backend::cli_lines("-c " + backend::sq(cfg) + " init --plan --porcelain" + fsflag)
        let mut has_err: bool = false
        h = h + txt("Nothing has been changed yet. This is what will happen:", "sub")
        let mut i: int = 0
        while i < array_len(plan) is
            let kind: string = backend::field(plan[i], 0)
            let msg: string = backend::field(plan[i], 1)
            i += 1
            if kind == "fs" is
                h = h + txt("Filesystem: " + msg, "sel")
            else if kind == "step" is
                h = h + txt("•  " + msg, "step")
            else if kind == "warn" is
                h = h + txt("!  " + msg, "warn")
            else if kind == "error" is
                has_err = true
                h = h + txt("✗  " + msg, "err")
            end
        end
        if array_len(plan) == 0 is
            has_err = true
            h = h + txt("✗  could not read the plan — is hackeros-snapshots installed?", "err")
        end
        h = h + "<div class=\"row\">" + btn("wz_back", "Back", "")
        if !has_err is h = h + btn("wz_apply", "Apply these changes", "primary") end
        h = h + "</div>"
    else is
        h = h + txt("Result:", "sel")
        let out: [string] = string_split(st(a, "lastout"), "\n")
        let mut i: int = 0
        while i < array_len(out) is
            if string_trim(out[i]) != "" is h = h + txt(string_trim(out[i]), "step") end
            i += 1
        end
        h = h + "<div class=\"row\">" + btn("wz_service", "Start the background service now", "primary") + btn("wz_again", "Run the wizard again", "") + btn("nav_snaps", "Go to snapshots", "") + "</div>"
    end
    return h + "</div>"
end
